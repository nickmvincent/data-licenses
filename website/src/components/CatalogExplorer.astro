---
import type { LoadedInitiative } from '../lib/content-loader';
import {
  ACTION_LABELS,
  PIPELINE_LABELS,
  STATUS_LABELS,
  formatApproachLabel,
  formatDataTypeLabel,
  formatDate,
  getEnforcementDetails,
  sortByFeaturedThenTitle,
} from '../lib/catalog';

interface Props {
  items: LoadedInitiative[];
}

const { items } = Astro.props;
const currentItems = items
  .filter((item) => item.visibility === 'public' && item.status !== 'archived')
  .sort(sortByFeaturedThenTitle);
const actions = Array.from(new Set(currentItems.flatMap((item) => item.actionsSupported))).sort((a, b) =>
  formatApproachLabel(a).localeCompare(formatApproachLabel(b))
);
const dataTypes = Array.from(new Set(currentItems.flatMap((item) => item.dataTypes))).sort((a, b) =>
  formatDataTypeLabel(a).localeCompare(formatDataTypeLabel(b))
);
const pipelineStages = Array.from(new Set(currentItems.flatMap((item) => item.pipelineStages))).sort((a, b) =>
  (PIPELINE_LABELS[a] || a).localeCompare(PIPELINE_LABELS[b] || b)
);
const approachGroups = Array.from(new Set(currentItems.map((item) => item.primaryApproachType)))
  .sort((a, b) => formatApproachLabel(a).localeCompare(formatApproachLabel(b)));

const adoptionLabel = (item: LoadedInitiative) =>
  [item.usersCount, item.dataVolume, item.moneyVolume].filter(Boolean).join(' · ');
const latestSourceHost = (item: LoadedInitiative) => {
  if (!item.latestEvidenceLink) return '';
  try {
    return new URL(item.latestEvidenceLink.url).hostname.replace(/^www\./, '');
  } catch {
    return 'Source';
  }
};
---

<section id="catalog" class="catalog-explorer" aria-labelledby="catalog-title">
  <header class="explorer-heading">
    <div>
      <h2 id="catalog-title">Browse initiatives</h2>
      <p>
        Search {currentItems.length} current initiatives or narrow the catalog by status, approach,
        data type, pipeline stage, and public adoption evidence.
      </p>
    </div>
    <p class="status-explainer">
      <strong>“Live” means publicly available.</strong>
      It does not mean widely adopted, legally tested, or effective against non-compliant actors.
    </p>
  </header>

  <div class="explorer-tools">
    <div class="explorer-toolbar">
      <div class="search-shell">
        <label for="catalog-search">Search title, summary, and profile text</label>
        <input
          id="catalog-search"
          type="search"
          placeholder="Search the catalog"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <fieldset class="status-switch">
        <legend>Status</legend>
        <div>
          <button type="button" data-status="all" aria-pressed="true">All</button>
          <button type="button" data-status="live" aria-pressed="false">Live</button>
          <button type="button" data-status="wip" aria-pressed="false">In progress</button>
        </div>
      </fieldset>

      <label class="sort-control">
        <span>Sort</span>
        <select id="catalog-sort">
          <option value="featured">Featured</option>
          <option value="alpha">A to Z</option>
          <option value="status">Status</option>
          <option value="latest">Latest evidence</option>
        </select>
      </label>

      <fieldset class="catalog-view-switch">
        <legend>Layout</legend>
        <div>
          <button type="button" data-view="single" aria-pressed="true">One table</button>
          <button type="button" data-view="grouped" aria-pressed="false">By category</button>
        </div>
      </fieldset>
    </div>

    <details id="catalog-filters" class="advanced-filters">
      <summary>
        <span>Filters</span>
        <span id="filter-summary">None selected</span>
      </summary>
      <div class="filter-panel">
        <div class="filter-block">
          <span class="filter-label">Approach</span>
          <div class="filter-options">
            {actions.map((action) => (
              <button type="button" data-filter-action={action} aria-pressed="false">
                {ACTION_LABELS[action] || action}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-block">
          <span class="filter-label">Data type</span>
          <div class="filter-options">
            {dataTypes.map((dataType) => (
              <button type="button" data-filter-type={dataType} aria-pressed="false">
                {formatDataTypeLabel(dataType)}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-block">
          <span class="filter-label">Pipeline stage</span>
          <div class="filter-options">
            {pipelineStages.map((stage) => (
              <button type="button" data-filter-stage={stage} aria-pressed="false">
                {PIPELINE_LABELS[stage] || stage}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-block">
          <span class="filter-label">Adoption evidence</span>
          <div class="filter-options">
            <button type="button" data-filter-adoption aria-pressed="false">
              Public figure available
            </button>
          </div>
        </div>

        <button type="button" id="reset-catalog" class="quiet-button" hidden>Reset filters</button>
      </div>
    </details>
  </div>

  <div class="results-bar" aria-live="polite">
    <p><strong id="catalog-count">{currentItems.length}</strong> <span id="catalog-count-label">initiatives</span></p>
    <p id="catalog-active-description" class="active-description">Showing all current initiatives.</p>
  </div>

  <div id="catalog-single-view">
    <div class="result-columns" aria-hidden="true">
      <span>Initiative</span>
      <span>Approach and scope</span>
      <span>Practical force</span>
      <span>Evidence</span>
    </div>

    <div id="catalog-results" class="catalog-results-list">
      {currentItems.map((item) => {
        const latest = item.latestEvidenceLink;
        const enforcement = getEnforcementDetails(item.primaryApproachType);
        const primaryLabel = formatApproachLabel(item.primaryApproachType);
        const secondaryLabels = item.actionsSupported
          .filter((action) => action !== item.primaryApproachType)
          .map((action) => formatApproachLabel(action));
        const dataTypeLabels = item.dataTypes.map((value) => formatDataTypeLabel(value));
        const stageLabels = item.pipelineStages.map((value) => PIPELINE_LABELS[value] || value);
        const adoption = adoptionLabel(item);
        const searchText = [item.title, item.summary, item.body].join(' ').toLowerCase();

        return (
          <article
            class="catalog-result"
            data-search={searchText}
            data-status={item.status}
            data-category={item.primaryApproachType}
            data-actions={item.actionsSupported.join(' ')}
            data-types={item.dataTypes.join(' ')}
            data-stages={item.pipelineStages.join(' ')}
            data-latest={item.latestUpdate ? String(new Date(item.latestUpdate).getTime()) : '0'}
            data-featured-rank={String(item.featuredRank)}
            data-has-adoption={adoption ? 'true' : 'false'}
            data-title={item.title}
          >
            <div class="result-main">
              <div class="result-titleline">
                <h3><a href={`/initiatives/${item.slug}`}>{item.title}</a></h3>
                <span class={`badge ${item.status}`}>{STATUS_LABELS[item.status] || item.status}</span>
              </div>
              <p>{item.summary}</p>
              <div class="result-actions">
                <a href={`/initiatives/${item.slug}`}>Open profile</a>
                <a href={item.website} target="_blank" rel="noopener">Official site</a>
              </div>
            </div>

            <div class="result-fit" data-mobile-label="Approach and scope">
              <strong>{primaryLabel}</strong>
              {secondaryLabels.length > 0 && <span>Also: {secondaryLabels.join(' · ')}</span>}
              <span>{stageLabels.join(' · ')}</span>
              <span>{dataTypeLabels.join(' · ')}</span>
            </div>

            <div class="result-enforcement" data-mobile-label="Practical force">
              <strong>{enforcement.shortLabel}</strong>
              <span>{enforcement.caveat}</span>
            </div>

            <div class="result-evidence" data-mobile-label="Evidence">
              {latest ? (
                <>
                  <strong>{formatDate(latest.date)}</strong>
                  <a href={latest.url} target="_blank" rel="noopener" title={latest.label}>
                    {latestSourceHost(item)}
                  </a>
                </>
              ) : (
                <strong>No dated evidence</strong>
              )}
              <span>Checked {formatDate(item.lastChecked)}</span>
              <span>{adoption || 'No public adoption figure found'}</span>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <div id="catalog-grouped-view" class="catalog-grouped-view" hidden>
    {approachGroups.map((approach) => (
      <section class="catalog-category" data-category-group={approach} hidden>
        <header class="catalog-category-heading">
          <h3>{formatApproachLabel(approach)}</h3>
          <span><span data-category-count={approach}>0</span> initiatives</span>
        </header>
        <div class="result-columns" aria-hidden="true">
          <span>Initiative</span>
          <span>Approach and scope</span>
          <span>Practical force</span>
          <span>Evidence</span>
        </div>
        <div class="catalog-results-list" data-category-results={approach}></div>
      </section>
    ))}
  </div>

  <p id="catalog-empty" class="empty-state" hidden>
    No initiatives match these filters. <button type="button" id="clear-empty">Reset filters</button>
  </p>

  <p class="archive-link">
    Looking for older projects? <a href="/archive">Browse archived initiatives</a>.
  </p>
</section>

<script>
  // @ts-nocheck
  import {
    catalogQueryFromSearch,
    catalogUrlForQuery,
    compareCatalogRecords,
    matchesCatalogRecord,
  } from '../lib/catalog-view.js';

  const root = document.querySelector('.catalog-explorer');
  if (root instanceof HTMLElement) {
    const one = (selector) => root.querySelector(selector);
    const all = (selector) => Array.from(root.querySelectorAll(selector));
    const search = one('#catalog-search');
    const sort = one('#catalog-sort');
    const results = one('#catalog-results');
    const count = one('#catalog-count');
    const countLabel = one('#catalog-count-label');
    const activeDescription = one('#catalog-active-description');
    const empty = one('#catalog-empty');
    const reset = one('#reset-catalog');
    const panel = one('#catalog-filters');
    const panelSummary = one('#filter-summary');
    const singleView = one('#catalog-single-view');
    const groupedView = one('#catalog-grouped-view');
    const rows = all('.catalog-result');
    const statusButtons = all('[data-status]');
    const actionButtons = all('[data-filter-action]');
    const typeButtons = all('[data-filter-type]');
    const stageButtons = all('[data-filter-stage]');
    const adoptionButton = one('[data-filter-adoption]');
    const viewButtons = all('[data-view]');
    const categoryGroups = all('[data-category-group]');

    const pressedValues = (buttons, key) =>
      buttons
        .filter((button) => button.getAttribute('aria-pressed') === 'true')
        .map((button) => button.dataset[key])
        .filter(Boolean);
    const setPressed = (button, value) => button?.setAttribute('aria-pressed', String(value));
    const setExclusive = (buttons, active) =>
      buttons.forEach((button) => setPressed(button, button.dataset.status === active || button.dataset.view === active));

    const recordFor = (row) => ({
      title: row.dataset.title || '',
      search: row.dataset.search || '',
      status: row.dataset.status || '',
      actions: (row.dataset.actions || '').split(' ').filter(Boolean),
      dataTypes: (row.dataset.types || '').split(' ').filter(Boolean),
      pipelineStages: (row.dataset.stages || '').split(' ').filter(Boolean),
      hasAdoption: row.dataset.hasAdoption === 'true',
      latest: Number(row.dataset.latest || 0),
      featuredRank: Number(row.dataset.featuredRank || Number.MAX_SAFE_INTEGER),
    });

    function state() {
      return {
        query: search instanceof HTMLInputElement ? search.value : '',
        status: statusButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.status || 'all',
        actions: pressedValues(actionButtons, 'filterAction'),
        dataTypes: pressedValues(typeButtons, 'filterType'),
        pipelineStages: pressedValues(stageButtons, 'filterStage'),
        adoption: adoptionButton?.getAttribute('aria-pressed') === 'true',
        sort: sort instanceof HTMLSelectElement ? sort.value : 'featured',
        view: viewButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.view || 'single',
      };
    }

    function syncQuery(query) {
      history.replaceState(null, '', catalogUrlForQuery(window.location.pathname, query));
    }

    function applyCatalog() {
      if (!(results instanceof HTMLElement) || !(count instanceof HTMLElement)) return;
      const current = state();
      const visible = rows
        .filter((row) => matchesCatalogRecord(recordFor(row), current))
        .sort((a, b) => compareCatalogRecords(recordFor(a), recordFor(b), current.sort));

      rows.forEach((row) => {
        row.hidden = !visible.includes(row);
      });

      if (current.view === 'grouped') {
        if (singleView instanceof HTMLElement) singleView.hidden = true;
        if (groupedView instanceof HTMLElement) groupedView.hidden = false;
        categoryGroups.forEach((group) => {
          const category = group.dataset.categoryGroup;
          const groupRows = visible.filter((row) => row.dataset.category === category);
          const destination = group.querySelector('[data-category-results]');
          const groupCount = group.querySelector('[data-category-count]');
          group.hidden = groupRows.length === 0;
          if (groupCount) groupCount.textContent = String(groupRows.length);
          groupRows.forEach((row) => destination?.append(row));
        });
      } else {
        if (singleView instanceof HTMLElement) singleView.hidden = false;
        if (groupedView instanceof HTMLElement) groupedView.hidden = true;
        visible.forEach((row) => results.append(row));
      }

      const filterCount =
        (current.status === 'all' ? 0 : 1) +
        current.actions.length +
        current.dataTypes.length +
        current.pipelineStages.length +
        (current.adoption ? 1 : 0);
      count.textContent = String(visible.length);
      if (countLabel) countLabel.textContent = visible.length === 1 ? 'initiative' : 'initiatives';
      if (empty instanceof HTMLElement) empty.hidden = visible.length !== 0;
      if (reset instanceof HTMLButtonElement) reset.hidden = filterCount === 0 && !current.query;
      if (panelSummary) panelSummary.textContent = filterCount ? `${filterCount} selected` : 'None selected';
      if (activeDescription) {
        activeDescription.textContent =
          current.query || filterCount
            ? `Filtered from ${rows.length} current initiatives.`
            : 'Showing all current initiatives.';
      }
      syncQuery(current.query);
    }

    function clearCatalog() {
      if (search instanceof HTMLInputElement) search.value = '';
      if (sort instanceof HTMLSelectElement) sort.value = 'featured';
      setExclusive(statusButtons, 'all');
      setExclusive(viewButtons, 'single');
      [...actionButtons, ...typeButtons, ...stageButtons].forEach((button) => setPressed(button, false));
      setPressed(adoptionButton, false);
      applyCatalog();
    }

    statusButtons.forEach((button) =>
      button.addEventListener('click', () => {
        setExclusive(statusButtons, button.dataset.status);
        applyCatalog();
      })
    );
    viewButtons.forEach((button) =>
      button.addEventListener('click', () => {
        setExclusive(viewButtons, button.dataset.view);
        applyCatalog();
      })
    );
    [...actionButtons, ...typeButtons, ...stageButtons].forEach((button) =>
      button.addEventListener('click', () => {
        setPressed(button, button.getAttribute('aria-pressed') !== 'true');
        applyCatalog();
      })
    );
    adoptionButton?.addEventListener('click', () => {
      setPressed(adoptionButton, adoptionButton.getAttribute('aria-pressed') !== 'true');
      applyCatalog();
    });
    search?.addEventListener('input', applyCatalog);
    sort?.addEventListener('change', applyCatalog);
    reset?.addEventListener('click', clearCatalog);
    one('#clear-empty')?.addEventListener('click', clearCatalog);

    const initialQuery = catalogQueryFromSearch(window.location.search);
    if (search instanceof HTMLInputElement) search.value = initialQuery;
    if (initialQuery && panel instanceof HTMLDetailsElement) panel.open = true;
    applyCatalog();
  }
</script>

<style>
  .catalog-explorer {
    scroll-margin-top: 72px;
    display: grid;
    gap: 20px;
    padding-top: clamp(28px, 5vw, 56px);
    border-top: 1px solid var(--border-strong);
  }

  .explorer-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
    gap: 24px 48px;
    align-items: end;
  }

  .explorer-heading h2 {
    margin-bottom: 8px;
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  .explorer-heading p,
  .active-description,
  .archive-link {
    margin: 0;
    color: var(--muted);
  }

  .status-explainer {
    padding: 12px 16px;
    border-left: 3px solid var(--accent);
    background: var(--card);
    font-size: 0.9rem;
  }

  .status-explainer strong {
    display: block;
    color: var(--text);
  }

  .explorer-tools {
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .explorer-toolbar {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) auto auto auto;
    gap: 12px;
    align-items: end;
    padding: 14px 0;
  }

  .search-shell,
  .sort-control {
    display: grid;
    gap: 5px;
  }

  .search-shell label,
  .sort-control span,
  fieldset legend,
  .filter-label {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .search-shell input,
  .sort-control select {
    min-height: 44px;
    border-radius: 0;
    border-color: var(--border-strong);
  }

  .sort-control select {
    min-width: 150px;
    padding: 0 36px 0 12px;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  fieldset > div {
    display: flex;
    min-height: 44px;
    border: 1px solid var(--border-strong);
  }

  .status-switch button,
  .catalog-view-switch button,
  .filter-options button,
  .quiet-button,
  .empty-state button {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }

  .status-switch button,
  .catalog-view-switch button {
    padding: 0 11px;
    border-right: 1px solid var(--border);
    white-space: nowrap;
  }

  .status-switch button:last-child,
  .catalog-view-switch button:last-child {
    border-right: 0;
  }

  button[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .advanced-filters {
    border-top: 1px solid var(--border);
  }

  .advanced-filters summary {
    min-height: 48px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    cursor: pointer;
    font-weight: 700;
  }

  .advanced-filters summary span:last-child {
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 400;
  }

  .filter-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 28px;
    padding: 20px 0 24px;
    border-top: 1px solid var(--border);
  }

  .filter-block {
    display: grid;
    gap: 9px;
    align-content: start;
  }

  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .filter-options button,
  .quiet-button {
    min-height: 38px;
    padding: 7px 10px;
    border: 1px solid var(--border);
    background: var(--card);
    font-size: 0.88rem;
  }

  .quiet-button {
    justify-self: start;
    color: var(--text);
  }

  .results-bar {
    min-height: 34px;
    display: flex;
    gap: 12px 20px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .results-bar p {
    margin: 0;
  }

  .result-columns,
  .catalog-result {
    display: grid;
    grid-template-columns: minmax(260px, 1.55fr) minmax(180px, 0.9fr) minmax(190px, 0.95fr) minmax(145px, 0.7fr);
    gap: 18px;
  }

  .result-columns {
    padding: 0 12px 9px;
    border-bottom: 1px solid var(--border-strong);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .catalog-results-list {
    border-bottom: 1px solid var(--border-strong);
  }

  .catalog-result {
    align-items: start;
    padding: 18px 12px;
    border-bottom: 1px solid var(--border);
  }

  .catalog-result:last-child {
    border-bottom: 0;
  }

  .result-main,
  .result-fit,
  .result-enforcement,
  .result-evidence {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 5px;
  }

  .result-titleline {
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .result-titleline h3 {
    font-size: 1.15rem;
  }

  .result-titleline h3 a {
    color: var(--text);
    text-decoration-color: transparent;
  }

  .result-titleline h3 a:hover {
    text-decoration-color: currentColor;
  }

  .result-main > p,
  .result-fit span,
  .result-enforcement span,
  .result-evidence span {
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .result-fit strong,
  .result-enforcement strong,
  .result-evidence strong {
    font-size: 0.9rem;
  }

  .result-actions {
    display: flex;
    gap: 12px;
    margin-top: 3px;
    font-size: 0.84rem;
  }

  .result-evidence a {
    overflow-wrap: anywhere;
  }

  .catalog-grouped-view {
    display: grid;
    gap: 32px;
  }

  .catalog-category-heading {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 10px;
  }

  .catalog-category-heading span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .empty-state {
    margin: 0;
    padding: 28px;
    border: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
  }

  .empty-state button {
    color: var(--accent);
    text-decoration: underline;
  }

  .archive-link {
    padding-top: 4px;
  }

  @media (max-width: 1040px) {
    .explorer-toolbar {
      grid-template-columns: minmax(240px, 1fr) auto auto;
    }

    .catalog-view-switch {
      grid-column: 2 / -1;
      justify-self: end;
    }
  }

  @media (max-width: 780px) {
    .explorer-heading,
    .filter-panel {
      grid-template-columns: 1fr;
    }

    .explorer-toolbar {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .search-shell {
      grid-column: 1 / -1;
    }

    .status-switch,
    .catalog-view-switch {
      grid-column: auto;
      justify-self: stretch;
    }

    fieldset > div {
      width: 100%;
    }

    fieldset button {
      flex: 1;
    }

    .result-columns {
      display: none;
    }

    .catalog-result {
      grid-template-columns: 1fr;
      gap: 15px;
      padding: 20px 0;
    }

    .result-fit,
    .result-enforcement,
    .result-evidence {
      padding-top: 13px;
      border-top: 1px solid var(--border);
    }

    [data-mobile-label]::before {
      content: attr(data-mobile-label);
      color: var(--muted);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }

