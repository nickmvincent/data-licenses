---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'DataLicenses.org',
  description = 'A curated catalog of public initiatives shaping AI data access, licensing, technical enforcement, and creator leverage.',
  image = '/social-card.svg',
  type = 'website',
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = title === 'DataLicenses.org' ? title : `${title} | DataLicenses.org`;
const site = Astro.site ?? new URL('https://datalicenses.org');
const canonicalUrl = new URL(currentPath, site).toString();
const socialImageUrl = new URL(image, site).toString();
const isGuidePath = currentPath.startsWith('/methodology') || currentPath.startsWith('/contributing');
const isCatalogPath =
  currentPath === '/catalog' || currentPath.startsWith('/catalog/') || currentPath.startsWith('/initiatives/');
const isNavActive = (href: string) =>
  href === '/catalog'
    ? isCatalogPath
    : href === '/'
      ? currentPath === '/'
    : href === '/methodology'
      ? isGuidePath
      : currentPath.startsWith(href);

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/catalog', label: 'Catalog' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/methodology', label: 'Methodology' },
];

const alsoLikeLinks = [
  {
    href: 'https://sr.ithaka.org/our-work/generative-ai-licensing-agreement-tracker',
    label: 'Data Deals Tracker',
    desc: 'Tracks licensing agreements between AI companies and content providers.',
  },
  {
    href: 'https://www.mckoolsmith.com/newsroom-ailitigation',
    label: 'AI Litigation Tracker',
    desc: 'Maintains a broad list of lawsuits involving AI and data rights.',
  },
  {
    href: 'https://exploringai.org/',
    label: 'ExploringAI.org',
    desc: 'Research notes and quantitative sketches about AI data flows.',
  },
  {
    href: 'https://datalevers.org',
    label: 'DataLevers.org',
    desc: 'Tools and strategy for collective action around data rights.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-name" content="DataLicenses.org" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f7f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111312" />
    <meta property="og:site_name" content="DataLicenses.org" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="DataLicenses.org catalog preview" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const storageKey = 'theme';
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        const saved = localStorage.getItem(storageKey);
        const theme = saved === 'light' || saved === 'dark'
          ? saved
          : mediaQuery.matches
            ? 'dark'
            : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="navbar">
      <div class="navbar-inner">
        <a href="/" class="navbar-brand">
          <span class="brand-wordmark">DataLicenses.org</span>
        </a>

        <button
          type="button"
          id="nav-toggle"
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav-panel"
          aria-label="Open navigation menu"
        >
          <span class="nav-toggle-label">Menu</span>
          <span class="nav-toggle-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>

        <div id="site-nav-panel" class="navbar-links">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'nav-link',
                { active: isNavActive(link.href) },
              ]}
              aria-current={isNavActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}

          <a href="/data/initiatives.json" class="nav-link nav-link-secondary" title="JSON API" aria-label="Open the catalog API">API</a>
        </div>

        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          title="Switch to dark theme"
          aria-label="Switch to dark theme"
          aria-pressed="false"
        >
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </nav>

    <div id="main-content" tabindex="-1">
      <slot />
    </div>

    <footer class="also-like-footer">
      <div class="also-like-inner">
        <div class="also-like-heading">
          <p class="also-like-kicker">Adjacent work</p>
          <p class="also-like-label">Trackers and research projects related to AI data rights.</p>
        </div>
        <div class="also-like-links">
          {alsoLikeLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener" class="also-like-link">
              <span class="also-like-name">{link.label}</span>
              <span class="also-like-desc">{link.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const navbar = document.querySelector('.navbar');
        const toggle = document.getElementById('theme-toggle');
        const navToggle = document.getElementById('nav-toggle');
        const storageKey = 'theme';
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        const desktopNavMedia = window.matchMedia('(min-width: 721px)');

        function readStoredTheme() {
          const saved = localStorage.getItem(storageKey);
          return saved === 'light' || saved === 'dark' ? saved : null;
        }

        function currentSystemTheme() {
          return mediaQuery.matches ? 'dark' : 'light';
        }

        function applyTheme(theme) {
          const isDark = theme === 'dark';
          root.classList.toggle('dark', isDark);

          if (toggle instanceof HTMLButtonElement) {
            const nextTheme = isDark ? 'light' : 'dark';
            toggle.setAttribute('aria-pressed', String(isDark));
            toggle.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
            toggle.title = `Switch to ${nextTheme} theme`;
          }
        }

        function setNavOpen(isOpen) {
          if (!(navbar instanceof HTMLElement) || !(navToggle instanceof HTMLButtonElement)) return;

          navbar.classList.toggle('menu-open', isOpen);
          navToggle.setAttribute('aria-expanded', String(isOpen));
          navToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');

          const label = navToggle.querySelector('.nav-toggle-label');
          if (label) label.textContent = isOpen ? 'Close' : 'Menu';
        }

        applyTheme(readStoredTheme() || currentSystemTheme());

        if (toggle) {
          toggle.addEventListener('click', () => {
            const nextTheme = root.classList.contains('dark') ? 'light' : 'dark';
            applyTheme(nextTheme);
            localStorage.setItem(storageKey, nextTheme);
          });
        }

        if (navbar instanceof HTMLElement && navToggle instanceof HTMLButtonElement) {
          setNavOpen(false);

          navToggle.addEventListener('click', () => {
            setNavOpen(!navbar.classList.contains('menu-open'));
          });

          navbar.querySelectorAll('.navbar-links a').forEach((link) => {
            link.addEventListener('click', () => {
              if (!desktopNavMedia.matches) setNavOpen(false);
            });
          });

          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && navbar.classList.contains('menu-open')) {
              setNavOpen(false);
            }
          });
        }

        const legacyExecCommand = /** @type {{ [key: string]: any }} */ (document)['execCommand']?.bind(document);
        const legacyAddListener = /** @type {{ [key: string]: any }} */ (mediaQuery)['addListener']?.bind(mediaQuery);
        const legacyDesktopAddListener = /** @type {{ [key: string]: any }} */ (desktopNavMedia)['addListener']?.bind(desktopNavMedia);

        async function copyText(value) {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(value);
            return true;
          }

          const probe = document.createElement('textarea');
          probe.value = value;
          probe.setAttribute('readonly', '');
          probe.style.position = 'absolute';
          probe.style.left = '-9999px';
          document.body.appendChild(probe);
          probe.select();

          try {
            return legacyExecCommand?.('copy') !== false;
          } catch {
            return false;
          } finally {
            document.body.removeChild(probe);
          }
        }

        document.addEventListener('click', async (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const button = target.closest('.copy');
          if (!(button instanceof HTMLButtonElement)) return;

          const rawCopyValue = button.getAttribute('data-copy');
          const codeValue = button.getAttribute('data-code');
          const value = rawCopyValue || decodeURIComponent(codeValue || '');
          if (!value) return;

          const defaultLabel = button.dataset.resetLabel || button.textContent || 'Copy';
          const didCopy = await copyText(value);
          button.textContent = didCopy ? 'Copied' : 'Copy failed';

          window.setTimeout(() => {
            button.textContent = defaultLabel;
          }, 1200);
        });

        /** @param {MediaQueryListEvent} event */
        const onSystemThemeChange = (event) => {
          if (readStoredTheme()) return;
          applyTheme(event.matches ? 'dark' : 'light');
        };

        if (typeof mediaQuery.addEventListener === 'function') {
          mediaQuery.addEventListener('change', onSystemThemeChange);
        } else if (typeof legacyAddListener === 'function') {
          legacyAddListener(onSystemThemeChange);
        }

        const onDesktopNavChange = () => {
          if (desktopNavMedia.matches) setNavOpen(false);
        };

        if (typeof desktopNavMedia.addEventListener === 'function') {
          desktopNavMedia.addEventListener('change', onDesktopNavChange);
        } else if (typeof legacyDesktopAddListener === 'function') {
          legacyDesktopAddListener(onDesktopNavChange);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 16px;
    top: 14px;
    z-index: 200;
    padding: 0.72rem 0.95rem;
    border-radius: 8px;
    background: var(--accent);
    color: #f6f3ee;
    text-decoration: none;
    transform: translateY(-180%);
    transition: transform 0.18s ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 94%, var(--bg));
  }

  .navbar-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    min-height: 46px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
  }

  .navbar-brand {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text);
  }

  .navbar-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 0.2rem 0;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    color: var(--text);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      color 0.18s ease;
  }

  .nav-link:hover {
    border-bottom-color: var(--border-strong);
    background: none;
    text-decoration: none;
  }

  .nav-link.active {
    border-bottom-color: var(--accent);
    background: none;
    color: var(--accent);
  }

  .nav-link-secondary {
    min-height: 30px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    color: var(--muted);
  }

  .nav-link-secondary:hover {
    border-bottom-color: var(--border-strong);
    background: none;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 2px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted);
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      color 0.18s ease,
      background 0.18s ease;
  }

  .theme-toggle:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    color: var(--text);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    gap: 0.75rem;
    min-height: 32px;
    padding: 0 0.75rem;
    border-radius: 2px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    cursor: pointer;
    font-weight: 600;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      color 0.18s ease;
  }

  .nav-toggle:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    background: var(--accent-soft);
  }

  .nav-toggle-icon {
    display: inline-grid;
    gap: 3px;
  }

  .nav-toggle-icon span {
    width: 14px;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }

  .navbar.menu-open .nav-toggle-icon span:nth-child(1) {
    transform: translateY(4.5px) rotate(45deg);
  }

  .navbar.menu-open .nav-toggle-icon span:nth-child(2) {
    opacity: 0;
  }

  .navbar.menu-open .nav-toggle-icon span:nth-child(3) {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  .icon-sun {
    display: none;
  }

  .icon-moon {
    display: block;
  }

  :root.dark .icon-sun {
    display: block;
  }

  :root.dark .icon-moon {
    display: none;
  }

  .also-like-footer {
    margin-top: 1.75rem;
    padding: 1.35rem 1.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .also-like-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(180px, 230px) minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .also-like-heading {
    display: grid;
    gap: 0.35rem;
  }

  .also-like-kicker {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .also-like-label {
    margin: 0;
    color: var(--muted);
  }

  .also-like-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0 18px;
  }

  .also-like-link {
    display: grid;
    gap: 0.3rem;
    padding: 0.55rem 0;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .also-like-link:hover {
    border-color: var(--border-strong);
    text-decoration: none;
  }

  .also-like-name {
    font-weight: 700;
    color: var(--text);
  }

  .also-like-desc {
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .also-like-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .navbar-inner {
      padding: 10px 16px;
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 8px;
    }

    .brand-wordmark {
      font-size: 1rem;
    }

    .nav-toggle {
      display: inline-flex;
      grid-column: 3;
      grid-row: 1;
      width: 32px;
      padding: 0;
      justify-content: center;
    }

    .nav-toggle-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .navbar-links {
      display: none;
      grid-column: 1 / -1;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 0 0;
      border: 1px solid var(--border);
      border-radius: 0;
      background: var(--card);
      box-shadow: var(--shadow-soft);
    }

    .navbar.menu-open .navbar-links {
      display: flex;
    }

    .nav-link {
      width: 100%;
      min-height: 44px;
      justify-content: flex-start;
      padding: 0 0.9rem;
      border: 1px solid transparent;
      border-radius: 0;
      white-space: normal;
    }

    .nav-link:hover {
      border-color: var(--border-strong);
      border-bottom-color: var(--border-strong);
      background: var(--surface-muted);
    }

    .nav-link.active {
      border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
      background: color-mix(in srgb, var(--accent-soft) 45%, transparent);
    }

    .theme-toggle {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }
  }
</style>
