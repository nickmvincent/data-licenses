---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DataLicenses.org',
  description = 'A curated catalog of public initiatives shaping AI data access, licensing, technical enforcement, and creator leverage.',
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = title === 'DataLicenses.org' ? title : `${title} | DataLicenses.org`;
const isNavActive = (href: string) =>
  href === '/'
    ? currentPath === '/' || currentPath.startsWith('/initiatives/')
    : currentPath.startsWith(href);

const navLinks = [
  { href: '/', label: 'Catalog' },
  { href: '/memo', label: 'Memo' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/contributing', label: 'Contribute' },
];

const alsoLikeLinks = [
  {
    href: 'https://sr.ithaka.org/our-work/generative-ai-licensing-agreement-tracker',
    label: 'Data Deals Tracker',
    desc: 'Tracks licensing agreements between AI companies and content providers.',
  },
  {
    href: 'https://www.mckoolsmith.com/newsroom-ailitigation',
    label: 'AI Litigation Tracker',
    desc: 'Maintains a broad list of lawsuits involving AI and data rights.',
  },
  {
    href: 'https://exploringai.org/',
    label: 'ExploringAI.org',
    desc: 'Research notes and napkin math about AI data flows.',
  },
  {
    href: 'https://datalevers.org',
    label: 'DataLevers.org',
    desc: 'Tools and strategy for collective action around data rights.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe6" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const storageKey = 'theme';
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        const saved = localStorage.getItem(storageKey);
        const theme = saved === 'light' || saved === 'dark'
          ? saved
          : mediaQuery.matches
            ? 'dark'
            : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="navbar">
      <div class="navbar-inner">
        <a href="/" class="navbar-brand">
          <span class="brand-wordmark">DataLicenses.org</span>
          <span class="brand-tag">AI data rights field guide</span>
        </a>

        <div class="navbar-links">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'nav-link',
                { active: isNavActive(link.href) },
              ]}
              aria-current={isNavActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}

          <a href="/data/initiatives.json" class="nav-link nav-link-secondary" title="JSON API" aria-label="Open the catalog API">API</a>

          <button type="button" id="theme-toggle" class="theme-toggle" title="Toggle light or dark theme" aria-label="Toggle theme">
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>
      </div>
    </nav>

    <div id="main-content" tabindex="-1">
      <slot />
    </div>

    <footer class="also-like-footer">
      <div class="also-like-inner">
        <div class="also-like-heading">
          <p class="also-like-kicker">Adjacent work</p>
          <p class="also-like-label">Trackers and research projects worth keeping open in the next tab.</p>
        </div>
        <div class="also-like-links">
          {alsoLikeLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener" class="also-like-link">
              <span class="also-like-name">{link.label}</span>
              <span class="also-like-desc">{link.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.getElementById('theme-toggle');
        const storageKey = 'theme';
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

        function readStoredTheme() {
          const saved = localStorage.getItem(storageKey);
          return saved === 'light' || saved === 'dark' ? saved : null;
        }

        function currentSystemTheme() {
          return mediaQuery.matches ? 'dark' : 'light';
        }

        function applyTheme(theme) {
          root.classList.toggle('dark', theme === 'dark');
        }

        applyTheme(readStoredTheme() || currentSystemTheme());

        if (toggle) {
          toggle.addEventListener('click', () => {
            const nextTheme = root.classList.contains('dark') ? 'light' : 'dark';
            applyTheme(nextTheme);
            localStorage.setItem(storageKey, nextTheme);
          });
        }

        const legacyExecCommand = /** @type {{ [key: string]: any }} */ (document)['execCommand']?.bind(document);
        const legacyAddListener = /** @type {{ [key: string]: any }} */ (mediaQuery)['addListener']?.bind(mediaQuery);

        async function copyText(value) {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(value);
            return true;
          }

          const probe = document.createElement('textarea');
          probe.value = value;
          probe.setAttribute('readonly', '');
          probe.style.position = 'absolute';
          probe.style.left = '-9999px';
          document.body.appendChild(probe);
          probe.select();

          try {
            return legacyExecCommand?.('copy') !== false;
          } catch {
            return false;
          } finally {
            document.body.removeChild(probe);
          }
        }

        document.addEventListener('click', async (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const button = target.closest('.copy');
          if (!(button instanceof HTMLButtonElement)) return;

          const rawCopyValue = button.getAttribute('data-copy');
          const codeValue = button.getAttribute('data-code');
          const value = rawCopyValue || decodeURIComponent(codeValue || '');
          if (!value) return;

          const defaultLabel = button.dataset.resetLabel || button.textContent || 'Copy';
          const didCopy = await copyText(value);
          button.textContent = didCopy ? 'Copied' : 'Copy failed';

          window.setTimeout(() => {
            button.textContent = defaultLabel;
          }, 1200);
        });

        /** @param {MediaQueryListEvent} event */
        const onSystemThemeChange = (event) => {
          if (readStoredTheme()) return;
          applyTheme(event.matches ? 'dark' : 'light');
        };

        if (typeof mediaQuery.addEventListener === 'function') {
          mediaQuery.addEventListener('change', onSystemThemeChange);
        } else if (typeof legacyAddListener === 'function') {
          legacyAddListener(onSystemThemeChange);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 16px;
    top: 14px;
    z-index: 200;
    padding: 0.72rem 0.95rem;
    border-radius: 999px;
    background: var(--accent);
    color: #f6f3ee;
    text-decoration: none;
    transform: translateY(-180%);
    transition: transform 0.18s ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .navbar-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    min-height: 68px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .navbar-brand {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    color: inherit;
    text-decoration: none;
  }

  .brand-wordmark {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .brand-tag {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 0.9rem;
    border-radius: 999px;
    border: 1px solid transparent;
    color: var(--text);
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 600;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      color 0.18s ease;
  }

  .nav-link:hover {
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--card) 75%, transparent);
    text-decoration: none;
  }

  .nav-link.active {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    background: var(--accent-soft);
    color: var(--accent);
  }

  .nav-link-secondary {
    color: var(--muted);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 92%, transparent);
    color: var(--muted);
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      color 0.18s ease,
      background 0.18s ease;
  }

  .theme-toggle:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    color: var(--text);
  }

  .icon-sun {
    display: none;
  }

  .icon-moon {
    display: block;
  }

  :root.dark .icon-sun {
    display: block;
  }

  :root.dark .icon-moon {
    display: none;
  }

  .also-like-footer {
    margin-top: 3rem;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 66%, transparent);
  }

  .also-like-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(220px, 300px) minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .also-like-heading {
    display: grid;
    gap: 0.35rem;
  }

  .also-like-kicker {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--warm);
  }

  .also-like-label {
    margin: 0;
    color: var(--muted);
  }

  .also-like-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  .also-like-link {
    display: grid;
    gap: 0.3rem;
    padding: 14px 16px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 94%, transparent);
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .also-like-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: var(--shadow-soft);
    text-decoration: none;
  }

  .also-like-name {
    font-weight: 700;
    color: var(--text);
  }

  .also-like-desc {
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .also-like-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .navbar-inner {
      padding: 12px 16px;
      align-items: flex-start;
      flex-direction: column;
    }

    .navbar-links {
      width: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .nav-link {
      min-height: 38px;
      white-space: nowrap;
    }

    .theme-toggle {
      flex: 0 0 auto;
    }
  }
</style>
