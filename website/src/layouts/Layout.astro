---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'DataLicenses.org',
  description = 'A public reference catalog of licenses and license-adjacent infrastructure for AI data use.',
  image = '/social-card.png',
  type = 'website',
  noindex = false,
  structuredData = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = title === 'DataLicenses.org' ? title : `${title} | DataLicenses.org`;
const site = Astro.site ?? new URL('https://datalicenses.org');
const canonicalUrl = new URL(currentPath, site).toString();
const socialImageUrl = new URL(image, site).toString();
const contactUrl = 'https://github.com/nickmvincent/data-licenses/issues/new/choose';

const navLinks = [
  { href: '/', label: 'Browse' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/contributing', label: 'Contribute' },
  { href: '/about', label: 'About' },
  { href: '/updates', label: 'Updates' },
  { href: '/data', label: 'Data' },
  { href: contactUrl, label: 'Contact', external: true },
];

const isNavActive = (href: string) => {
  if (href.startsWith('http')) return false;
  if (href === '/') return currentPath === '/' || currentPath.startsWith('/initiatives/');
  return currentPath === href || currentPath.startsWith(`${href}/`);
};

const relatedLinks = [
  {
    href: 'https://sr.ithaka.org/our-work/generative-ai-licensing-agreement-tracker',
    label: 'Data Deals Tracker',
  },
  {
    href: 'https://exploringai.org/',
    label: 'ExploringAI.org',
  },
  {
    href: 'https://datalevers.org',
    label: 'DataLevers.org',
  },
];

const baseStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DataLicenses.org',
    url: site.toString(),
    description:
      'A public reference catalog of licenses and license-adjacent infrastructure for AI data use.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'DataLicenses.org',
    url: site.toString(),
    sameAs: ['https://github.com/nickmvincent/data-licenses'],
  },
];
const customStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = JSON.stringify([...baseStructuredData, ...customStructuredData].filter(Boolean))
  .replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-name" content="DataLicenses.org" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f7f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111312" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="DataLicenses.org" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="DataLicenses.org" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        document.documentElement.classList.toggle(
          'dark',
          window.matchMedia('(prefers-color-scheme: dark)').matches
        );
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="navbar" aria-label="Primary">
      <div class="navbar-inner">
        <a href="/" class="navbar-brand" aria-label="DataLicenses.org home">
          <span class="brand-wordmark">DataLicenses.org</span>
        </a>

        <button
          type="button"
          id="nav-toggle"
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav-panel"
        >
          Menu
        </button>

        <div id="site-nav-panel" class="navbar-links">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={['nav-link', { active: isNavActive(link.href) }]}
              aria-current={isNavActive(link.href) ? 'page' : undefined}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>

        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          title="Switch color theme"
          aria-label="Switch color theme"
          aria-pressed="false"
        >
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </nav>

    <div id="main-content" tabindex="-1">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-section">
          <strong>DataLicenses.org</strong>
          <p>
            Public evidence about licenses and license-adjacent infrastructure for AI data use.
          </p>
          <p>
            Catalog data and written content are licensed under
            <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener">CC BY 4.0</a>.
            Site code is <a href="https://github.com/nickmvincent/data-licenses" target="_blank" rel="noopener">MIT licensed</a>.
          </p>
        </div>

        <div class="footer-section">
          <strong>Site</strong>
          <div class="footer-links">
            <a href="/archive">Archive</a>
            <a href="/data">Data and downloads</a>
            <a href="/contributing">Contribute</a>
            <a href="/about#disclosures">Disclosures</a>
            <a href="https://github.com/nickmvincent/data-licenses/security" target="_blank" rel="noopener">Security</a>
          </div>
        </div>

        <div class="footer-section">
          <strong>Related projects</strong>
          <div class="footer-links">
            {relatedLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
            ))}
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const navbar = document.querySelector('.navbar');
        const themeToggle = document.getElementById('theme-toggle');
        const navToggle = document.getElementById('nav-toggle');
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
        const desktopNav = window.matchMedia('(min-width: 961px)');
        let manualTheme = false;

        function applyTheme(isDark) {
          root.classList.toggle('dark', isDark);
          if (themeToggle instanceof HTMLButtonElement) {
            themeToggle.setAttribute('aria-pressed', String(isDark));
            themeToggle.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
            themeToggle.title = `Switch to ${isDark ? 'light' : 'dark'} theme`;
          }
        }

        function setNavOpen(isOpen) {
          if (!(navbar instanceof HTMLElement) || !(navToggle instanceof HTMLButtonElement)) return;
          navbar.classList.toggle('menu-open', isOpen);
          navToggle.setAttribute('aria-expanded', String(isOpen));
          navToggle.textContent = isOpen ? 'Close' : 'Menu';
        }

        applyTheme(systemTheme.matches);

        themeToggle?.addEventListener('click', () => {
          manualTheme = true;
          applyTheme(!root.classList.contains('dark'));
        });

        const onSystemThemeChange = (event) => {
          if (!manualTheme) applyTheme(event.matches);
        };
        systemTheme.addEventListener?.('change', onSystemThemeChange);

        if (navbar instanceof HTMLElement && navToggle instanceof HTMLButtonElement) {
          setNavOpen(false);
          navToggle.addEventListener('click', () => setNavOpen(!navbar.classList.contains('menu-open')));
          navbar.querySelectorAll('.navbar-links a').forEach((link) => {
            link.addEventListener('click', () => {
              if (!desktopNav.matches) setNavOpen(false);
            });
          });
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && navbar.classList.contains('menu-open')) {
              setNavOpen(false);
              navToggle.focus();
            }
          });
          desktopNav.addEventListener?.('change', () => {
            if (desktopNav.matches) setNavOpen(false);
          });
        }

        async function copyText(value) {
          if (!navigator.clipboard?.writeText) return false;
          try {
            await navigator.clipboard.writeText(value);
            return true;
          } catch {
            return false;
          }
        }

        document.addEventListener('click', async (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest('.copy');
          if (!(button instanceof HTMLButtonElement)) return;
          const value = button.getAttribute('data-copy') ||
            decodeURIComponent(button.getAttribute('data-code') || '');
          if (!value) return;
          const original = button.textContent || 'Copy';
          button.textContent = await copyText(value) ? 'Copied' : 'Copy failed';
          window.setTimeout(() => {
            button.textContent = original;
          }, 1200);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 16px;
    top: 12px;
    z-index: 300;
    padding: 0.7rem 0.9rem;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 95%, var(--bg));
  }

  .navbar-inner {
    max-width: 1180px;
    min-height: 50px;
    margin: 0 auto;
    padding: 7px 24px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
  }

  .navbar-brand {
    color: var(--text);
    text-decoration: none;
  }

  .brand-wordmark {
    font-size: 0.96rem;
    font-weight: 700;
  }

  .navbar-links {
    min-width: 0;
    display: flex;
    justify-content: flex-end;
    gap: 5px 13px;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-link {
    padding: 0.15rem 0;
    border-bottom: 1px solid transparent;
    color: var(--text);
    font-size: 0.84rem;
    text-decoration: none;
  }

  .nav-link:hover {
    border-bottom-color: var(--border-strong);
    text-decoration: none;
  }

  .nav-link.active {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }

  .theme-toggle,
  .nav-toggle {
    min-width: 34px;
    min-height: 34px;
    border: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .theme-toggle {
    padding: 0;
  }

  .nav-toggle {
    display: none;
    padding: 0 10px;
  }

  .site-footer {
    margin-top: 24px;
    padding: 30px 24px 36px;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 1.5fr) repeat(2, minmax(180px, 0.7fr));
    gap: 28px 48px;
  }

  .footer-section {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .footer-section p {
    max-width: 600px;
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-links {
    display: grid;
    gap: 5px;
  }

  .footer-links a {
    justify-self: start;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 960px) {
    .navbar-inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      padding: 8px 16px;
    }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      grid-column: 3;
      grid-row: 1;
    }

    .theme-toggle {
      grid-column: 2;
      grid-row: 1;
    }

    .navbar-links {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      justify-content: flex-start;
      align-items: stretch;
      gap: 0;
      padding-top: 8px;
    }

    .js .navbar-links {
      display: none;
    }

    .js .navbar.menu-open .navbar-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nav-link {
      min-height: 44px;
      display: flex;
      align-items: center;
      padding: 0 12px;
      border: 1px solid var(--border);
      border-bottom: 0;
    }

    .nav-link:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }

    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-section:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .js .navbar.menu-open .navbar-links,
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .nav-link:nth-last-child(2) {
      border-bottom: 0;
    }

    .footer-section:first-child {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
