---
import Layout from '../layouts/Layout.astro';
import { loadInitiatives } from '../lib/content-loader';

type GlossaryLink = {
  label: string;
  url: string;
};

type GlossaryTerm = {
  term: string;
  definition: string;
  related: string[];
  externalLinks: GlossaryLink[];
};

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const searchTextForTerm = (item: GlossaryTerm) =>
  [
    item.term,
    item.definition,
    item.related.join(' '),
    item.externalLinks.map((externalLink) => externalLink.label).join(' '),
  ]
    .join(' ')
    .toLowerCase();

const initiatives = await loadInitiatives();
const catalogInitiativeBySlug = new Map(initiatives.map((item) => [item.slug, item]));

const link = (label: string, url: string): GlossaryLink => ({ label, url });

const catalogLink = (slug: string, label?: string): GlossaryLink => {
  const initiative = catalogInitiativeBySlug.get(slug);
  if (!initiative) {
    throw new Error(`Glossary expected catalog initiative slug "${slug}" to exist.`);
  }

  return {
    label: label ?? initiative.title,
    url: initiative.website,
  };
};

const catalogEvidenceLink = (
  slug: string,
  labelContains: string,
  label?: string
): GlossaryLink => {
  const initiative = catalogInitiativeBySlug.get(slug);
  if (!initiative) {
    throw new Error(`Glossary expected catalog initiative slug "${slug}" to exist.`);
  }

  const target = initiative.evidenceLinks.find((item) =>
    item.label.toLowerCase().includes(labelContains.toLowerCase())
  );
  if (!target) {
    throw new Error(
      `Glossary expected catalog initiative slug "${slug}" to have evidence matching "${labelContains}".`
    );
  }

  return {
    label: label ?? target.label,
    url: target.url,
  };
};

const terms: GlossaryTerm[] = [
  {
    term: 'Preference Signal',
    definition: 'A machine-readable hint that tells AI agents or web crawlers how content may or may not be used. Examples include robots.txt directives, ai.txt files, and HTTP headers. These rely on voluntary compliance by the crawler.',
    related: ['robots.txt', 'ai.txt', 'TDMRep', 'Asset-level Signal'],
    externalLinks: [
      catalogLink('ai-pref', 'IETF AI Preferences'),
      catalogLink('tdmrep', 'W3C TDMRep'),
    ],
  },
  {
    term: 'robots.txt',
    definition: 'A text file placed at the root of a website that instructs web crawlers which pages they may or may not access. Originally designed for search engines, now being extended for AI training crawlers with user-agent specific rules.',
    related: ['Preference Signal', 'X-Robots-Tag'],
    externalLinks: [link('Robot Exclusion Protocol (RFC 9309)', 'https://www.rfc-editor.org/rfc/rfc9309')],
  },
  {
    term: 'ai.txt',
    definition: 'A proposed standard (similar to robots.txt) specifically for communicating AI-related permissions. Allows site owners to express preferences about AI training, retrieval, and generation uses of their content.',
    related: ['Preference Signal', 'robots.txt'],
    externalLinks: [catalogLink('ai-txt', 'Spawning ai.txt')],
  },
  {
    term: 'API',
    definition: 'A programmatic interface for requesting data or services. In this catalog, APIs can become tollgates, licensed delivery channels, or enforcement points for AI-relevant data access.',
    related: ['Tollgate', 'Data Market Platform'],
    externalLinks: [link('MDN API glossary', 'https://developer.mozilla.org/en-US/docs/Glossary/API')],
  },
  {
    term: 'Asset-level Signal',
    definition: 'A preference or rights signal attached to an individual file or work rather than to an entire website or domain. These signals are useful when content moves between platforms or needs permissions that travel with the asset itself.',
    related: ['Preference Signal', 'Data Provenance', 'X-Robots-Tag'],
    externalLinks: [
      catalogLink('adobe-content-authenticity', 'Adobe Content Authenticity'),
      catalogLink('tdm-ai', 'TDM·AI'),
    ],
  },
  {
    term: 'Attribution',
    definition: 'Credit connecting content back to its source, author, or steward. It can involve citations, links, provenance metadata, or contractual reporting requirements.',
    related: ['Data Provenance', 'Training Data'],
    externalLinks: [link('Creative Commons attribution guidance', 'https://wiki.creativecommons.org/wiki/Recommended_practices_for_attribution')],
  },
  {
    term: 'Bot Authentication',
    definition: 'Methods for verifying the identity of an automated client and conveying who operates it. In AI access control, stronger bot identity can make rate limits, differentiated permissions, and enforcement more reliable.',
    related: ['Technical Control', 'Preference Signal'],
    externalLinks: [catalogLink('web-bot-auth', 'IETF Web Bot Auth')],
  },
  {
    term: 'Certification',
    definition: 'A third-party review or badge signaling that a model, dataset, or vendor meets a stated standard, such as consented training-data sourcing.',
    related: ['Fairly Trained'],
    externalLinks: [catalogLink('fairlytrained', 'Fairly Trained')],
  },
  {
    term: 'Enforcement',
    definition: 'The practical ability to make a permission, restriction, or access condition matter. A preference signal may rely on voluntary compliance; a contract may create legal obligations between parties; and a technical control may block or meter a particular access path. None guarantees control in every context.',
    related: ['Preference Signal', 'Technical Control', 'Tollgate'],
    externalLinks: [],
  },
  {
    term: 'TDMRep',
    definition: 'Text and Data Mining Reservation Protocol. A W3C Community Group effort for expressing TDM policies, typically via a machine-readable `/.well-known/tdmrep.json` file for EU DSM Directive opt-outs.',
    related: ['Preference Signal', 'W3C'],
    externalLinks: [catalogLink('tdmrep', 'W3C TDMRep')],
  },
  {
    term: 'Licensing Collective',
    definition: 'An organization that manages rights on behalf of multiple creators, negotiating licenses and distributing payments. Examples include ASCAP for music and newer publisher or creator collectives negotiating AI-related uses.',
    related: ['RSL', 'Rights Holder'],
    externalLinks: [catalogLink('publishers-rights', "Publishers' Rights Organization")],
  },
  {
    term: 'RSL (Really Simple Licensing)',
    definition: 'A machine-readable licensing format that allows content creators to specify terms for AI use of their work. Designed to be easily parsed by automated systems for compliance checking.',
    related: ['Licensing Collective', 'Preference Signal'],
    externalLinks: [catalogLink('rsl', 'RSL standard')],
  },
  {
    term: 'Privacy-Preserving Computation',
    definition: 'Ways of training, evaluating, or collaborating on AI systems without freely exposing the underlying raw data. In this catalog, it points to approaches where data holders keep more custody and control while still enabling model development.',
    related: ['Training Data', 'Data Provenance'],
    externalLinks: [
      catalogLink('syftbox', 'SyftBox'),
      catalogLink('flexolmo', 'FlexOlmo'),
    ],
  },
  {
    term: 'Tollgate',
    definition: 'A technical mechanism that requires payment, authentication, or rate limiting for automated access to content. Allows monetization of bot traffic while maintaining control over access.',
    related: ['Technical Control', 'API'],
    externalLinks: [catalogLink('tollbit', 'TollBit')],
  },
  {
    term: 'Technical Control',
    definition: 'Measures that detect, limit, or block unwanted automated access to content. Includes rate limiting, CAPTCHAs, bot detection, and fingerprinting. Unlike preference signals, these are enforced rather than advisory.',
    related: ['Tollgate', 'Scraping', 'Bot Authentication'],
    externalLinks: [catalogLink('cloudflare-anti-scraping', 'Cloudflare AI Crawl Control')],
  },
  {
    term: 'Scraping',
    definition: 'The automated extraction of content from websites. AI companies scrape the web to collect training data. May violate terms of service or copyright depending on jurisdiction and use.',
    related: ['Technical Control', 'Training Data'],
    externalLinks: [catalogLink('cloudflare-anti-scraping', 'Cloudflare AI Crawl Control')],
  },
  {
    term: 'Training Data',
    definition: 'The collection of text, images, code, or other content used to train machine learning models. The provenance, licensing, and consent around training data is a central issue in AI governance.',
    related: ['Scraping', 'Pipeline Stage'],
    externalLinks: [
      catalogEvidenceLink(
        'bria-artist-program',
        'Licensed training catalog',
        'Bria licensed training catalog'
      ),
    ],
  },
  {
    term: 'Pipeline Stage',
    definition: 'A phase in the AI data lifecycle. Common stages include collection or scraping, training, fine-tuning, retrieval, and user-facing output generation.',
    related: ['Training Data', 'RAG'],
    externalLinks: [link('NIST AI lifecycle tasks', 'https://airc.nist.gov/airmf-resources/airmf/appendices/app-a-descriptions-of-ai-actor-tasks/')],
  },
  {
    term: 'RAG (Retrieval-Augmented Generation)',
    definition: 'A technique where AI models retrieve relevant documents at inference time to augment their responses. Raises different licensing questions than training since content is accessed dynamically.',
    related: ['Pipeline Stage'],
    externalLinks: [link('Original RAG paper (DOI)', 'https://doi.org/10.48550/arXiv.2005.11401')],
  },
  {
    term: 'Data Market Platform',
    definition: 'A platform that helps rights holders or data owners offer licensed access to content or datasets for AI use. These systems often handle discovery, permissions, pricing, delivery, and reporting for training or retrieval use cases.',
    related: ['Tollgate', 'Licensing Collective', 'Training Data'],
    externalLinks: [
      catalogLink('defined-ai-marketplace', 'Defined.ai'),
      catalogLink('protege', 'Protege'),
    ],
  },
  {
    term: 'Data Provenance',
    definition: 'The documented history of a piece of data: where it came from, how it was processed, and what permissions apply. Critical for compliance and attribution in AI systems.',
    related: ['Training Data', 'Attribution', 'Registry'],
    externalLinks: [link('W3C PROV overview', 'https://www.w3.org/TR/prov-overview/')],
  },
  {
    term: 'Opt-out',
    definition: 'A mechanism allowing content creators to indicate they do not want their work used for AI training. May be technical (robots.txt) or legal (GDPR rights). Effectiveness depends on crawler compliance.',
    related: ['Preference Signal', 'Opt-in', 'Registry'],
    externalLinks: [catalogLink('do-not-train-registry', 'Spawning Do Not Train Registry')],
  },
  {
    term: 'Opt-in',
    definition: 'A consent model where explicit permission is required before content can be used. More protective than opt-out but harder to scale. Some licensing collectives operate on opt-in basis.',
    related: ['Licensing Collective', 'Opt-out'],
    externalLinks: [catalogLink('created-by-humans', 'Created by Humans')],
  },
  {
    term: 'IETF AIPref',
    definition: 'A proposed Internet Engineering Task Force standard for AI preference signaling. Aims to create a standardized, extensible format for expressing AI-related permissions across the internet.',
    related: ['Preference Signal', 'ai.txt'],
    externalLinks: [catalogLink('ai-pref', 'IETF AI Preferences')],
  },
  {
    term: 'Fairly Trained',
    definition: 'A certification program that verifies AI models were trained with proper consent and licensing. Provides third-party validation that a model meets ethical training criteria.',
    related: ['Certification'],
    externalLinks: [catalogLink('fairlytrained', 'Fairly Trained')],
  },
  {
    term: 'Registry',
    definition: 'A shared list or lookup service that records rights, preferences, or status information about works. In this space, registries can help others discover opt-outs, verify rights claims, or check reuse conditions across many assets.',
    related: ['Opt-out', 'Data Provenance', 'Rights Holder'],
    externalLinks: [
      catalogLink('do-not-train-registry', 'Spawning Do Not Train Registry'),
      catalogLink('commonsdb', 'CommonsDB'),
    ],
  },
  {
    term: 'Rights Holder',
    definition: 'The person or organization that controls the relevant rights in a work or dataset, and can authorize, refuse, or condition reuse. Rights holders may be creators, publishers, labels, archives, or other stewards depending on the context.',
    related: ['Licensing Collective', 'Data Market Platform', 'Opt-in'],
    externalLinks: [
      catalogLink('created-by-humans', 'Created by Humans'),
      catalogLink('iptc-plus-data-mining-metadata', 'IPTC + PLUS Data Mining Metadata'),
    ],
  },
  {
    term: 'W3C',
    definition: 'The World Wide Web Consortium, a standards body that incubates web specifications and community group proposals relevant to machine-readable signals and protocols.',
    related: ['TDMRep'],
    externalLinks: [link('W3C about page', 'https://www.w3.org/about/')],
  },
  {
    term: 'X-Robots-Tag',
    definition: 'An HTTP response header that lets a server send crawler instructions along with a page or file response. It is useful when a site needs per-URL or per-file rules instead of relying only on a site-wide `robots.txt` file.',
    related: ['robots.txt', 'Preference Signal', 'Asset-level Signal'],
    externalLinks: [
      catalogLink('robots-ai-directives', 'OpenAI bots documentation'),
      link('MDN X-Robots-Tag', 'https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/X-Robots-Tag'),
    ],
  },
  {
    term: 'Status: Live',
    definition: 'The initiative is publicly available or deployable today. The label does not mean that it is widely adopted, legally tested, or proven effective.',
    related: [],
    externalLinks: [link('Merriam-Webster: go live', 'https://www.merriam-webster.com/dictionary/go%20live')],
  },
];

// Sort alphabetically
terms.sort((a, b) => a.term.localeCompare(b.term));
const relatedAliases = new Map([
  ['RAG', 'RAG (Retrieval-Augmented Generation)'],
  ['RSL', 'RSL (Really Simple Licensing)'],
]);
const termSlugByName = new Map(terms.map((item) => [item.term, slugify(item.term)]));
const relatedSlug = (value: string) => termSlugByName.get(relatedAliases.get(value) || value);

// Group by first letter
const grouped = terms.reduce((acc, t) => {
  const letter = t.term[0].toUpperCase();
  if (!acc[letter]) acc[letter] = [];
  acc[letter].push(t);
  return acc;
}, {} as Record<string, typeof terms>);
const letters = Object.keys(grouped).sort();
const totalTerms = terms.length;
const newTabAriaLabel = (label: string) => `${label} (opens in a new tab)`;
---

<Layout
  title="Glossary"
  description="Definitions and related references for the AI data licensing, access, and enforcement landscape."
>
  <main class="wrap glossary-page">
    <header class="page-header glossary-header">
      <h1 class="page-title-sm">Glossary</h1>
      <p class="muted glossary-intro">
        Key terms and concepts used throughout the data licensing landscape.
      </p>
    </header>

    <section class="glossary-toolbar box">
      <div class="glossary-search-shell">
        <label class="sr-only" for="glossary-search">Search glossary terms</label>
        <svg class="glossary-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          id="glossary-search"
          type="search"
          placeholder="Search terms, definitions, and related concepts"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <p class="glossary-meta"><span id="glossary-count">{totalTerms}</span> terms</p>
    </section>

    <nav id="letter-nav" class="letter-nav">
      {letters.map(letter => (
        <a href={`#letter-${letter}`} class="letter-link">{letter}</a>
      ))}
    </nav>

    <div class="glossary">
      {letters.map(letter => (
        <section id={`letter-${letter}`} class="letter-section">
          <h2 class="letter-heading">{letter}</h2>
          <div class="terms">
            {grouped[letter].map(item => (
              <article class="term-card" id={slugify(item.term)} data-search={searchTextForTerm(item)}>
                <h3 class="term-name">{item.term}</h3>
                <p class="term-definition">{item.definition}</p>
                {item.externalLinks.length > 0 && (
                  <div class="term-links">
                    <span class="term-meta-label">External:</span>
                    {item.externalLinks.map((externalLink, i) => (
                      <span>
                        <a
                          href={externalLink.url}
                          target="_blank"
                          rel="noopener"
                          class="related-link"
                          aria-label={newTabAriaLabel(externalLink.label)}
                        >
                          {externalLink.label}
                        </a>
                        {i < item.externalLinks.length - 1 && ', '}
                      </span>
                    ))}
                  </div>
                )}
                {item.related && item.related.length > 0 && (
                  <div class="term-related">
                    <span class="term-meta-label">Related:</span>
                    {item.related.map((r, i) => (
                      <span>
                        {relatedSlug(r) ? (
                          <a href={`#${relatedSlug(r)}`} class="related-link">{r}</a>
                        ) : (
                          <span>{r}</span>
                        )}
                        {i < item.related.length - 1 && ', '}
                      </span>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p id="glossary-empty" class="glossary-empty muted" hidden>No glossary terms match that search.</p>
  </main>

  <script>
    // @ts-nocheck
    (() => {
      const searchInput = document.getElementById('glossary-search');
      const count = document.getElementById('glossary-count');
      const emptyState = document.getElementById('glossary-empty');
      const letterNav = document.getElementById('letter-nav');
      const cards = Array.from(document.querySelectorAll('.term-card'));
      const sections = Array.from(document.querySelectorAll('.letter-section'));

      if (
        !(searchInput instanceof HTMLInputElement) ||
        !(count instanceof HTMLElement) ||
        !(emptyState instanceof HTMLElement) ||
        !(letterNav instanceof HTMLElement)
      ) {
        return;
      }

      function applySearch() {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const matches = !query || (card.dataset.search || '').includes(query);
          card.hidden = !matches;
          if (matches) visibleCount += 1;
        });

        sections.forEach((section) => {
          if (!(section instanceof HTMLElement)) return;
          const hasVisibleCards = Boolean(section.querySelector('.term-card:not([hidden])'));
          section.hidden = !hasVisibleCards;
        });

        count.textContent = String(visibleCount);
        emptyState.hidden = visibleCount !== 0;
        letterNav.hidden = Boolean(query);
      }

      searchInput.addEventListener('input', applySearch);
      applySearch();
    })();
  </script>
</Layout>

<style>
  .glossary-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 16px 18px;
    margin-bottom: 16px;
  }

  .glossary-search-shell {
    position: relative;
    flex: 1 1 320px;
    min-width: 260px;
  }

  .glossary-search-shell input {
    min-height: 48px;
    padding-left: 2.85rem;
  }

  .glossary-search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }

  .glossary-meta {
    margin: 0;
    color: var(--muted);
    font-weight: 600;
  }

  .term-card {
    scroll-margin-top: 100px;
  }

  .glossary-empty {
    margin: 18px 2px 0;
  }

  @media (max-width: 720px) {
    .glossary-search-shell {
      min-width: 0;
      width: 100%;
    }
  }
</style>
