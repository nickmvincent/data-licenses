---
import CatalogExplorer from '../components/CatalogExplorer.astro';
import Layout from '../layouts/Layout.astro';
import { loadInitiatives, type LoadedInitiative } from '../lib/content-loader';
import { APPROACH_KEYS, formatDate } from '../lib/catalog';

const items: LoadedInitiative[] = await loadInitiatives();
const currentItems = items.filter((item) => item.visibility === 'public' && item.status !== 'archived');
const liveItems = currentItems.filter((item) => item.status === 'live');
const latestTrackedUpdate = currentItems
  .map((item) => item.latestUpdate)
  .filter((value): value is Date => Boolean(value))
  .sort((a, b) => b.getTime() - a.getTime())[0];
---

<Layout
  title="DataLicenses.org"
  description="A public reference catalog of licenses and license-adjacent infrastructure for controlling how data is collected, shared, licensed, and used in AI pipelines."
>
  <main class="wrap home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title">Approaches for controlling how data is used in AI pipelines.</h1>
        <p class="hero-lede">
          DataLicenses.org tracks licenses, preference signals, markets, access controls, registries,
          standards, certification, and governed sharing for AI training, evaluation, retrieval, and
          generation.
        </p>
        <p class="hero-scope">
          The catalog focuses on permissions, terms, and controlled access. It does not cover complete
          withholding, data poisoning, litigation tracking, or general AI governance.
        </p>
        <a class="hero-primary" href="#catalog">Browse initiatives</a>
      </div>

      <aside class="boundary-note" aria-labelledby="boundary-title">
        <h2 id="boundary-title">Evidence, not endorsement</h2>
        <p>
          Profiles summarize public claims and dated sources. Inclusion is not legal advice,
          procurement advice, endorsement, or proof that an approach works.
        </p>
        <a href="/methodology">Read the methodology</a>
      </aside>
    </section>

    <dl class="catalog-snapshot">
      <div>
        <dt>Current initiatives</dt>
        <dd>{currentItems.length}</dd>
      </div>
      <div>
        <dt>Live</dt>
        <dd>{liveItems.length}</dd>
      </div>
      <div>
        <dt>Approach categories</dt>
        <dd>{APPROACH_KEYS.length}</dd>
      </div>
      <div>
        <dt>Latest tracked evidence</dt>
        <dd class="snapshot-date">{latestTrackedUpdate ? formatDate(latestTrackedUpdate) : 'Not recorded'}</dd>
      </div>
    </dl>

    <CatalogExplorer items={items} />
  </main>
</Layout>

<style>
  .home-page {
    max-width: 1120px;
    display: grid;
    gap: 38px;
    padding-top: 38px;
    padding-bottom: 56px;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.72fr);
    gap: 36px;
    align-items: end;
  }

  .hero-copy {
    display: grid;
    gap: 13px;
    align-content: start;
  }

  .hero-copy h1 {
    max-width: 800px;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.08;
  }

  .hero-lede {
    max-width: 760px;
    margin: 0;
    color: var(--text);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.5;
  }

  .hero-scope {
    max-width: 730px;
    margin: 0;
    color: var(--muted);
  }

  .hero-primary {
    justify-self: start;
    margin-top: 3px;
    font-weight: 600;
  }

  .boundary-note {
    display: grid;
    gap: 10px;
    padding-left: 20px;
    border-left: 3px solid var(--accent);
  }

  .boundary-note h2 {
    font-size: 1.15rem;
  }

  .boundary-note p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .boundary-note a {
    justify-self: start;
    font-size: 0.9rem;
  }

  .catalog-snapshot {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .catalog-snapshot div {
    display: grid;
    gap: 5px;
    min-width: 0;
    padding: 15px 16px;
    border-right: 1px solid var(--border);
  }

  .catalog-snapshot div:last-child {
    border-right: 0;
  }

  .catalog-snapshot dt {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .catalog-snapshot dd {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 600;
  }

  .catalog-snapshot .snapshot-date {
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (max-width: 780px) {
    .home-hero {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .boundary-note {
      max-width: 600px;
    }

    .catalog-snapshot {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .catalog-snapshot div:nth-child(2) {
      border-right: 0;
    }

    .catalog-snapshot div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 480px) {
    .home-page {
      padding-top: 28px;
    }

    .catalog-snapshot {
      grid-template-columns: 1fr;
    }

    .catalog-snapshot div {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .catalog-snapshot div:last-child {
      border-bottom: 0;
    }
  }
</style>
