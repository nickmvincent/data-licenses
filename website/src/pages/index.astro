---
import CatalogExplorer from '../components/CatalogExplorer.astro';
import Layout from '../layouts/Layout.astro';
import { loadInitiatives, type LoadedInitiative } from '../lib/content-loader';
import { formatApproachLabel, formatDate, sortByLatestThenTitle } from '../lib/catalog';

const items: LoadedInitiative[] = (await loadInitiatives()).sort(sortByLatestThenTitle);
const currentItems = items.filter((item) => item.visibility === 'public' && item.status !== 'archived');
const liveItems = currentItems.filter((item) => item.status === 'live');
const datedItems = currentItems.filter((item) => item.latestUpdate);
const recentlyActiveItems = [...datedItems].sort(sortByLatestThenTitle).slice(0, 6);
const latestTrackedUpdate = recentlyActiveItems[0]?.latestUpdate;

const sourceHost = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return 'Source';
  }
};
---

<Layout
  title="DataLicenses.org"
  description="Find and compare public initiatives for controlling, licensing, monetizing, and sourcing data for AI, with dated evidence and clear enforcement caveats."
>
  <main class="wrap home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">AI data rights and access</p>
        <h1 id="home-title">Find ways to control, license, sell, or source data for AI.</h1>
        <p class="hero-lede">
          A community-curated catalog of public initiatives, standards, services, and proposals—organized around
          the decisions people are trying to make.
        </p>
        <div class="hero-actions">
          <a class="hero-primary" href="#catalog">Browse and compare</a>
          <a href="/methodology">How the catalog works</a>
        </div>
      </div>

      <aside class="emerging-panel" aria-labelledby="emerging-title">
        <p class="eyebrow">Important context</p>
        <h2 id="emerging-title">Still emerging. Often voluntary.</h2>
        <p>
          Many AI-use signals depend on companies choosing to honor them. Legal theories remain unsettled,
          technical controls can be bypassed, and public adoption is uneven.
        </p>
        <ul>
          <li>A signal communicates a preference; it does not itself enforce one.</li>
          <li>An access control governs a route; it cannot guarantee control of downstream copies.</li>
          <li>“Live” means publicly available—not proven effective or legally validated.</li>
        </ul>
        <a href="/methodology#status-meanings">Read the status definitions</a>
      </aside>
    </section>

    <dl class="catalog-snapshot" aria-label="Catalog snapshot">
      <div>
        <dt>Current initiatives</dt>
        <dd>{currentItems.length}</dd>
      </div>
      <div>
        <dt>Publicly available</dt>
        <dd>{liveItems.length}</dd>
      </div>
      <div>
        <dt>With dated evidence</dt>
        <dd>{datedItems.length}</dd>
      </div>
      <div>
        <dt>Latest tracked evidence</dt>
        <dd class="snapshot-date">{latestTrackedUpdate ? formatDate(latestTrackedUpdate) : 'Not recorded'}</dd>
      </div>
    </dl>

    <section class="recent-section" aria-labelledby="recent-title">
      <header class="section-heading">
        <div>
          <p class="eyebrow">Recent evidence</p>
          <h2 id="recent-title">What has moved lately</h2>
        </div>
        <p>Newest dated public sources, not a ranking of importance or effectiveness.</p>
      </header>

      <div class="recent-grid">
        {recentlyActiveItems.map((item) => (
          <article class="recent-item">
            <div class="recent-meta">
              <span>{item.latestUpdate ? formatDate(item.latestUpdate) : 'No date'}</span>
              <span>{formatApproachLabel(item.primaryApproachType)}</span>
            </div>
            <h3><a href={`/initiatives/${item.slug}`}>{item.title}</a></h3>
            <p>{item.summary}</p>
            {item.latestEvidenceLink && (
              <a class="recent-source" href={item.latestEvidenceLink.url} target="_blank" rel="noopener" title={item.latestEvidenceLink.label}>
                {sourceHost(item.latestEvidenceLink.url)}
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <CatalogExplorer items={items} />
  </main>
</Layout>

<style>
  :global(body) {
    background: var(--bg);
  }

  .home-page {
    max-width: 1180px;
    display: grid;
    gap: clamp(34px, 5vw, 70px);
    padding-top: clamp(26px, 5vw, 62px);
    padding-bottom: 56px;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.75fr);
    gap: clamp(34px, 7vw, 86px);
    align-items: start;
  }

  .hero-copy {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-copy h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.35rem);
    font-weight: 450;
    letter-spacing: -0.045em;
    line-height: 0.94;
  }

  .hero-lede {
    max-width: 710px;
    margin: 0;
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    line-height: 1.5;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    gap: 11px 18px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 5px;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-weight: 700;
  }

  .hero-actions .hero-primary {
    padding: 10px 15px;
    border: 1px solid var(--text);
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
  }

  .emerging-panel {
    display: grid;
    gap: 13px;
    padding: 22px;
    border-top: 3px solid var(--accent);
    background: var(--card);
  }

  .emerging-panel h2 {
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    line-height: 1.05;
  }

  .emerging-panel p:not(.eyebrow),
  .emerging-panel ul {
    margin: 0;
    color: var(--muted);
  }

  .emerging-panel ul {
    display: grid;
    gap: 9px;
    padding-left: 1.1rem;
  }

  .emerging-panel a {
    justify-self: start;
    margin-top: 2px;
    font-size: 0.9rem;
  }

  .catalog-snapshot {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .catalog-snapshot div {
    display: grid;
    gap: 7px;
    padding: 15px 18px 17px;
    border-right: 1px solid var(--border);
  }

  .catalog-snapshot div:first-child {
    padding-left: 0;
  }

  .catalog-snapshot div:last-child {
    border-right: 0;
  }

  .catalog-snapshot dt {
    font-size: 0.76rem;
    color: var(--muted);
  }

  .catalog-snapshot dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
  }

  .catalog-snapshot .snapshot-date {
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 700;
  }

  .recent-section {
    display: grid;
    gap: 18px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
  }

  .section-heading h2 {
    margin: 3px 0 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .section-heading > p {
    max-width: 360px;
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong);
  }

  .recent-item {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 9px;
    padding: 17px 18px 19px;
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .recent-meta {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .recent-meta span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recent-item h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.15;
  }

  .recent-item h3 a {
    color: var(--text);
    text-decoration-color: transparent;
  }

  .recent-item h3 a:hover {
    text-decoration-color: currentColor;
  }

  .recent-item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .recent-source {
    justify-self: start;
    margin-top: auto;
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: 1fr;
    }

    .recent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .home-page {
      padding-top: 30px;
    }

    .hero-copy h1 {
      font-size: clamp(2.75rem, 14vw, 4.6rem);
    }

    .catalog-snapshot,
    .recent-grid {
      grid-template-columns: 1fr;
    }

    .catalog-snapshot div,
    .catalog-snapshot div:first-child {
      padding: 12px 0;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .catalog-snapshot div:last-child {
      border-bottom: 0;
    }

    .section-heading {
      display: grid;
      align-items: start;
    }
  }
</style>
