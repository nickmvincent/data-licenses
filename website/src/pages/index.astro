---
import Layout from '../layouts/Layout.astro';
import { loadInitiatives, type LoadedInitiative } from '../lib/content-loader';
import {
  APPROACH_DETAILS,
  APPROACH_KEYS,
  STATUS_LABELS,
  formatDate,
  sortByLatestThenTitle,
} from '../lib/catalog';

type CatalogApproachKey = (typeof APPROACH_KEYS)[number];

const items: LoadedInitiative[] = (await loadInitiatives()).sort(sortByLatestThenTitle);
const currentItems = items.filter((item) => item.status !== 'archived');
const datedItems = currentItems.filter((item) => item.latestUpdate);
const recentlyActiveItems = [...datedItems]
  .sort(sortByLatestThenTitle)
  .slice(0, 10);

const groupedItems: Array<{
  key: CatalogApproachKey;
  title: string;
  description: string;
  count: number;
  items: LoadedInitiative[];
}> = APPROACH_KEYS.map((key) => {
  const groupItems = currentItems.filter((item) => item.primaryApproachType === key);
  return {
    key,
    count: groupItems.length,
    items: groupItems,
    title: APPROACH_DETAILS[key].title,
    description: APPROACH_DETAILS[key].shortDescription,
  };
}).filter((group) => group.count > 0);

const latestTrackedUpdate = currentItems.reduce<Date | null>((latest, item) => {
  if (!item.latestUpdate) return latest;
  if (!latest) return item.latestUpdate;
  return new Date(item.latestUpdate).getTime() > new Date(latest).getTime() ? item.latestUpdate : latest;
}, null);

const rowNumberBySlug = new Map(currentItems.map((item, index) => [item.slug, index + 1]));
const githubRepoUrl = 'https://github.com/nickmvincent/data-licenses';
const catalogLinks = [
  { href: '/catalog', label: 'catalog' },
  { href: '/data/initiatives.json', label: 'data JSON' },
  { href: '/data/curation.json', label: 'curation JSON' },
  { href: '/prompts/find-updates.txt', label: 'review prompt' },
  { href: '/methodology#contribute', label: 'contribute' },
  { href: githubRepoUrl, label: 'github', external: true },
];

const metricLabel = (item: LoadedInitiative) => item.usersCount || item.dataVolume || item.moneyVolume || 'not recorded';
const statusLabel = (item: LoadedInitiative) => (STATUS_LABELS[item.status] || item.status).toLowerCase();
const approachLabel = (item: LoadedInitiative) => {
  const key = item.primaryApproachType as CatalogApproachKey;
  return APPROACH_DETAILS[key]?.title || item.primaryApproachType;
};
const rowNumber = (item: LoadedInitiative) => String(rowNumberBySlug.get(item.slug) || '').padStart(2, '0');
const rowCountLabel = (count: number) => `${count} ${count === 1 ? 'row' : 'rows'}`;
const sourceShortLabel = (item: LoadedInitiative) => {
  if (!item.latestEvidenceLink) return 'needs source';
  try {
    return new URL(item.latestEvidenceLink.url).hostname.replace(/^www\./, '');
  } catch {
    return 'source';
  }
};
const sourceDateLabel = (item: LoadedInitiative) =>
  item.latestUpdate ? formatDate(item.latestUpdate) : 'No dated source';
const updateIssueUrl = (item: LoadedInitiative) => {
  const title = `Update catalog row: ${item.title}`;
  const body = [
    `Row: ${item.title}`,
    `Slug: ${item.slug}`,
    '',
    'Suggested change:',
    '',
    'Source URL:',
    'Source date:',
  ].join('\n');
  return `${githubRepoUrl}/issues/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`;
};
---

<Layout
  title="DataLicenses.org"
  description="A hyper-curated catalog of public initiatives shaping AI data access, licensing, controlled retrieval, and technical enforcement."
>
  <main class="wrap catalog-home">
    <section class="workbook-cover" aria-labelledby="workbook-title">
      <div class="cover-copy">
        <h1 id="workbook-title" class="cover-title">DataLicenses.org</h1>
        <p class="cover-lede">
          A community-curated catalog of public initiatives shaping AI data access,
          licensing, controlled retrieval, and enforcement.
        </p>
        <p class="cover-note">
          Public sources, dated evidence, and update links.
        </p>
      </div>

      <dl class="cover-stats" aria-label="Catalog snapshot">
        <div>
          <dt>entries</dt>
          <dd>{currentItems.length}</dd>
        </div>
        <div>
          <dt>categories</dt>
          <dd>{groupedItems.length}</dd>
        </div>
        <div>
          <dt>dated sources</dt>
          <dd>{datedItems.length}</dd>
        </div>
        <div>
          <dt>latest evidence</dt>
          <dd>{latestTrackedUpdate ? formatDate(latestTrackedUpdate) : 'No dated source'}</dd>
        </div>
      </dl>

      <nav class="workbook-links" aria-label="Catalog links">
        {catalogLinks.map((link) => (
          <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </section>

    <section id="recently-active" class="sheet-section recent-sheet" aria-labelledby="recently-active-title">
      <header class="sheet-header">
        <div>
          <h2 id="recently-active-title" class="sheet-title">Recently active</h2>
          <p class="sheet-copy">
            Newest dated public evidence.
          </p>
        </div>
        <p class="sheet-note">
          Sorted by latest source date.
        </p>
      </header>

      <div class="sheet-frame recent-frame">
        <table class="ledger-table recent-table">
          <caption>Recently active initiatives</caption>
          <thead>
            <tr>
              <th scope="col" class="col-rank">row</th>
              <th scope="col">initiative</th>
              <th scope="col" class="col-medium">mechanism</th>
              <th scope="col" class="col-medium">adoption signal</th>
              <th scope="col" class="col-source">latest evidence</th>
              <th scope="col" class="col-action">update</th>
            </tr>
          </thead>
          <tbody>
            {recentlyActiveItems.map((item, index) => (
              <tr>
                <td class="cell-rank">{String(index + 1).padStart(2, '0')}</td>
                <th scope="row" class="cell-main">
                  <a class="row-title" href={`/initiatives/${item.slug}`}>{item.title}</a>
                  <span>{item.summary}</span>
                </th>
                <td>
                  <span>{approachLabel(item)}</span>
                  <span class="cell-muted">{statusLabel(item)}</span>
                </td>
                <td>{metricLabel(item)}</td>
                <td class="cell-source">
                  {item.latestEvidenceLink ? (
                    <>
                      <a
                        href={item.latestEvidenceLink.url}
                        target="_blank"
                        rel="noopener"
                        title={item.latestEvidenceLink.label}
                      >
                        {sourceShortLabel(item)}
                      </a>
                      <span>{sourceDateLabel(item)}</span>
                    </>
                  ) : (
                    <span>{sourceShortLabel(item)}</span>
                  )}
                </td>
                <td class="cell-actions">
                  <a href={`/initiatives/${item.slug}`}>profile</a>
                  <a href={updateIssueUrl(item)} target="_blank" rel="noopener">update</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <nav class="sheet-tabs" aria-label="Catalog sections">
      <a href="#recently-active">
        <span>recent</span>
        <b>{recentlyActiveItems.length}</b>
      </a>
      <a href="#all-initiatives">
        <span>all entries</span>
        <b>{currentItems.length}</b>
      </a>
      {groupedItems.map((group) => (
        <a href={`#group-${group.key}`}>
          <span>{group.title}</span>
          <b>{group.count}</b>
        </a>
      ))}
    </nav>

    <section id="all-initiatives" class="sheet-section all-catalog" aria-labelledby="all-initiatives-title">
      <header class="sheet-header">
        <div>
          <h2 id="all-initiatives-title" class="sheet-title">All current entries</h2>
          <p class="sheet-copy">
            Grouped by primary mechanism.
          </p>
        </div>
        <p class="sheet-note">
          Metrics appear when public evidence records them.
        </p>
      </header>

      <div class="approach-index" aria-label="Approach index">
        {groupedItems.map((group) => (
          <a href={`#group-${group.key}`}>
            <span>{group.title}</span>
            <span>{group.description}</span>
          </a>
        ))}
      </div>

      <div class="catalog-groups">
        {groupedItems.map((group) => (
          <section id={`group-${group.key}`} class="group-sheet" aria-labelledby={`group-title-${group.key}`}>
            <header class="group-sheet-header">
              <div>
                <h3 id={`group-title-${group.key}`} class="group-title">
                  {group.title} <span>{rowCountLabel(group.count)}</span>
                </h3>
                <p>{group.description}</p>
              </div>
              <a href="#all-initiatives">back to entries</a>
            </header>

            <div class="sheet-frame">
              <table class="ledger-table all-table">
                <caption>{group.title} initiatives</caption>
                <thead>
                  <tr>
                    <th scope="col" class="col-rank">row</th>
                    <th scope="col">initiative</th>
                    <th scope="col" class="col-small">status</th>
                    <th scope="col" class="col-medium">adoption signal</th>
                    <th scope="col" class="col-source">latest evidence</th>
                    <th scope="col" class="col-action">update</th>
                  </tr>
                </thead>
                <tbody>
                  {group.items.map((item) => (
                    <tr>
                      <td class="cell-rank">{rowNumber(item)}</td>
                      <th scope="row" class="cell-main">
                        <a class="row-title" href={`/initiatives/${item.slug}`}>{item.title}</a>
                        <span>{item.summary}</span>
                      </th>
                      <td>{statusLabel(item)}</td>
                      <td>{metricLabel(item)}</td>
                      <td class="cell-source">
                        {item.latestEvidenceLink ? (
                          <>
                            <a
                              href={item.latestEvidenceLink.url}
                              target="_blank"
                              rel="noopener"
                              title={item.latestEvidenceLink.label}
                            >
                              {sourceShortLabel(item)}
                            </a>
                            <span>{sourceDateLabel(item)}</span>
                          </>
                        ) : (
                          <span>{sourceShortLabel(item)}</span>
                        )}
                      </td>
                      <td class="cell-actions">
                        <a href={`/initiatives/${item.slug}`}>profile</a>
                        <a href={updateIssueUrl(item)} target="_blank" rel="noopener">update</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    background: var(--bg);
  }

  .catalog-home {
    display: grid;
    gap: clamp(24px, 3vw, 38px);
    max-width: 1240px;
    padding-top: 24px;
  }

  .catalog-home :is(h1, h2, h3) {
    letter-spacing: 0;
  }

  .workbook-cover,
  .sheet-section,
  .group-sheet {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .workbook-cover {
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 17rem);
    gap: 18px 24px;
    padding: 8px 0 20px;
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .cover-copy {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    max-width: 48rem;
  }

  .cover-title {
    font-size: clamp(1.9rem, 3.3vw, 3rem);
    line-height: 1;
  }

  .cover-lede,
  .cover-note,
  .sheet-copy,
  .sheet-note,
  .group-title + p {
    margin: 0;
    color: color-mix(in srgb, var(--text) 76%, var(--muted));
    line-height: 1.5;
  }

  .cover-lede {
    max-width: 42rem;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
  }

  .cover-note,
  .sheet-note {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .cover-stats {
    display: grid;
    align-content: start;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .cover-stats div {
    display: grid;
    gap: 0.12rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }

  .cover-stats dt,
  .cover-stats dd {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.25;
  }

  .cover-stats dt {
    color: var(--muted);
  }

  .cover-stats dd {
    color: var(--text);
    font-weight: 700;
    text-align: left;
  }

  .workbook-links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.1rem;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 0.88rem;
  }

  .workbook-links a,
  .sheet-tabs a,
  .approach-index a,
  .row-title,
  .cell-actions a,
  .group-sheet-header a,
  .cell-source a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .workbook-links a,
  .cell-actions a,
  .group-sheet-header a {
    color: var(--accent);
    font-weight: 700;
  }

  .sheet-header,
  .group-sheet-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px 28px;
    align-items: start;
  }

  .sheet-header > div,
  .group-sheet-header > div {
    display: grid;
    gap: 0.35rem;
  }

  .sheet-title,
  .group-title {
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .sheet-copy,
  .group-title + p {
    max-width: 42rem;
    font-size: 0.92rem;
  }

  .sheet-note {
    max-width: 24rem;
  }

  .sheet-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .sheet-tabs a {
    display: inline-grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem;
    min-width: 9rem;
    padding: 0.55rem 0.8rem 0.5rem 0;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    color: color-mix(in srgb, var(--text) 84%, var(--muted));
    font-size: 0.82rem;
  }

  .sheet-tabs b {
    color: var(--muted);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .approach-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
    border-top: 1px solid var(--border);
  }

  .approach-index a {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--border);
  }

  .approach-index a span:first-child {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .approach-index a span:last-child {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .catalog-groups {
    display: grid;
    gap: 26px;
  }

  .group-sheet {
    scroll-margin-top: 86px;
  }

  .group-title span {
    color: var(--muted);
    font-weight: 500;
  }

  .group-sheet-header a {
    justify-self: end;
    font-size: 0.82rem;
  }

  .sheet-frame {
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    border-top: 1px solid var(--border);
    scrollbar-width: thin;
  }

  .ledger-table {
    width: 100%;
    min-width: 900px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .recent-table {
    min-width: 980px;
  }

  .ledger-table caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ledger-table th,
  .ledger-table td {
    padding: 0.62rem 0.75rem 0.62rem 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    font-size: 0.86rem;
    line-height: 1.38;
  }

  .ledger-table thead th {
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .ledger-table tbody tr:hover {
    background: color-mix(in srgb, var(--surface-muted) 38%, transparent);
  }

  .col-rank {
    width: 3.6rem;
  }

  .col-small {
    width: 6.5rem;
  }

  .col-medium {
    width: 11rem;
  }

  .col-source {
    width: 14rem;
  }

  .col-action {
    width: 7rem;
  }

  .cell-rank {
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .cell-main > *,
  .cell-source > *,
  .cell-actions > * {
    display: block;
  }

  .cell-main > * + *,
  .cell-source > * + *,
  .cell-actions > * + * {
    margin-top: 0.25rem;
  }

  .row-title {
    color: var(--text);
    font-weight: 700;
  }

  .row-title:hover,
  .row-title:focus-visible,
  .cell-source a:hover,
  .cell-source a:focus-visible,
  .approach-index a:hover,
  .approach-index a:focus-visible,
  .sheet-tabs a:hover,
  .sheet-tabs a:focus-visible {
    color: var(--accent);
  }

  .cell-main span,
  .cell-main em,
  .cell-muted,
  .cell-source span {
    color: var(--muted);
    font-style: normal;
    font-size: 0.8rem;
  }

  .cell-main em {
    color: var(--accent);
    font-weight: 700;
  }

  .cell-actions a {
    font-size: 0.8rem;
  }

  @media (max-width: 1200px) {
    .sheet-header,
    .group-sheet-header {
      grid-template-columns: minmax(0, 1fr);
    }

    .group-sheet-header a {
      justify-self: start;
    }

    .sheet-note {
      max-width: 40rem;
    }
  }

  @media (max-width: 840px) {
    .workbook-cover,
    .approach-index {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .catalog-home {
      padding-top: 16px;
    }

    .cover-title {
      font-size: clamp(1.75rem, 8vw, 2.2rem);
    }

    .sheet-tabs a {
      min-width: 50%;
    }
  }
</style>
