---
import Layout from '../layouts/Layout.astro';
import { loadInitiatives, type LoadedInitiative } from '../lib/content-loader';
import { APPROACH_DETAILS, APPROACH_KEYS, formatDate, sortByLatestThenTitle } from '../lib/catalog';

type CatalogApproachKey = (typeof APPROACH_KEYS)[number];

const items: LoadedInitiative[] = (await loadInitiatives()).sort(sortByLatestThenTitle);
const currentItems = items.filter((item) => item.status !== 'archived');
const groupedItems: Array<{
  key: CatalogApproachKey;
  title: string;
  description: string;
  count: number;
}> = APPROACH_KEYS.map((key) => {
  const groupItems = currentItems.filter((item) => item.primaryApproachType === key);
  return {
    key,
    count: groupItems.length,
    title: APPROACH_DETAILS[key].title,
    description: APPROACH_DETAILS[key].shortDescription,
  };
}).filter((group) => group.count > 0);

const latestTrackedUpdate = currentItems.reduce<Date | null>((latest, item) => {
  if (!item.latestUpdate) return latest;
  if (!latest) return item.latestUpdate;
  return new Date(item.latestUpdate).getTime() > new Date(latest).getTime() ? item.latestUpdate : latest;
}, null);
---

<Layout
  title="DataLicenses.org"
  description="A working map of the main approaches to AI data access, licensing, and enforcement."
>
  <main class="wrap home-page">
    <section class="home-hero box">
      <div class="home-hero-copy">
        <p class="eyebrow">AI data access and licensing</p>
        <h1 class="home-title">Track the main ways people are trying to govern AI access to content.</h1>
        <p class="home-lede">
          DataLicenses.org is a working catalog of live and emerging initiatives around AI data
          licensing, access controls, marketplaces, collective bargaining, and enforcement.
        </p>
      </div>

      <div class="home-actions">
        <a class="btn btn-primary" href="/catalog">Open full catalog</a>
      </div>

      <p class="home-links">
        <a href="/memo">Memo</a>
        <span aria-hidden="true">·</span>
        <a href="/glossary">Glossary</a>
        <span aria-hidden="true">·</span>
        <a href="/methodology">Method &amp; contribute</a>
      </p>

      <p class="home-meta">
        {currentItems.length} current initiatives across {groupedItems.length} categories
        {latestTrackedUpdate && ` · Updated ${formatDate(latestTrackedUpdate)}`}
      </p>
    </section>

    <section class="home-categories">
      <div class="home-section-head">
        <div>
          <p class="eyebrow">Start with a category</p>
          <h2 class="home-section-title">Jump straight into the spreadsheet view</h2>
        </div>
        <p class="home-section-copy">
          Each card opens the catalog at that section so you can browse related initiatives right
          away.
        </p>
      </div>

      <div class="home-category-list">
        {groupedItems.map((group) => (
          <a
            class="home-category-item"
            href={`/catalog?view=spreadsheet#spreadsheet-group-${group.key}`}
          >
            <span class="home-category-main">
              <span class="home-category-topline">
                <span class="home-category-title">{group.title}</span>
                <span class="home-category-count">{group.count}</span>
              </span>
              <span class="home-category-description">{group.description}</span>
            </span>
            <span class="home-category-link">Open in catalog</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .home-page {
    display: grid;
    gap: 20px;
  }

  .home-hero {
    display: grid;
    gap: 16px;
    padding: clamp(24px, 5vw, 38px);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--card) 96%, transparent), color-mix(in srgb, var(--accent-soft) 10%, var(--card))),
      var(--card);
  }

  .home-hero-copy {
    display: grid;
    gap: 0.8rem;
    max-width: 50rem;
  }

  .home-title {
    max-width: 14ch;
    font-size: clamp(2.35rem, 5vw, 4.15rem);
  }

  .home-lede {
    margin: 0;
    max-width: 44rem;
    font-size: 1rem;
    line-height: 1.62;
    color: color-mix(in srgb, var(--text) 82%, var(--muted));
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .home-links,
  .home-meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
  }

  .home-links a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .home-categories {
    display: grid;
    gap: 14px;
  }

  .home-section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
  }

  .home-section-title {
    font-size: clamp(1.55rem, 3vw, 2.2rem);
  }

  .home-section-copy {
    max-width: 34rem;
    margin: 0;
    color: var(--muted);
  }

  .home-category-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .home-category-item {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .home-category-item:nth-child(odd) {
    padding-right: 20px;
  }

  .home-category-item:nth-child(even) {
    padding-left: 20px;
  }

  .home-category-item:hover,
  .home-category-item:focus-visible {
    color: var(--accent);
    text-decoration: none;
  }

  .home-category-main {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .home-category-topline {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
  }

  .home-category-title {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--text);
  }

  .home-category-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
    padding: 0 0.48rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-muted) 72%, var(--card));
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .home-category-description {
    color: var(--muted);
    line-height: 1.5;
  }

  .home-category-link {
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .home-title {
      max-width: 11ch;
      font-size: clamp(2rem, 10vw, 3.15rem);
    }

    .home-actions .btn {
      width: 100%;
    }

    .home-category-list {
      grid-template-columns: 1fr;
    }

    .home-category-item:nth-child(odd),
    .home-category-item:nth-child(even) {
      padding-left: 0;
      padding-right: 0;
    }

    .home-category-item {
      display: grid;
      gap: 0.7rem;
    }
  }
</style>
