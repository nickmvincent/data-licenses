<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://datalicenses.org/#catalog" />
    <title>Catalog | DataLicenses.org</title>
    <script is:inline>
      (() => {
        const target = new URL('/', window.location.origin);
        target.search = window.location.search;
        target.hash = 'catalog';
        window.location.replace(target);
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0;url=/#catalog" /></noscript>
  </head>
  <body>
    <p><a href="/#catalog">Continue to the catalog</a></p>
  </body>
</html>
