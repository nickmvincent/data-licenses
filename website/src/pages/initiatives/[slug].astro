---
import Layout from '../../layouts/Layout.astro';
import { getMarkdownProcessor } from '../../lib/markdown';
import { formatCitation, loadInitiatives } from '../../lib/content-loader';
import {
  ACTION_LABELS,
  PIPELINE_LABELS,
  STATUS_LABELS,
  formatApproachLabel,
  formatDataTypeLabel,
  formatDate,
  formatLinkLabel,
  formatLinkTitle,
  sortByLatestThenTitle,
} from '../../lib/catalog';

export async function getStaticPaths() {
  const initiatives = await loadInitiatives();
  return initiatives.map((item) => ({
    params: { slug: item.slug },
  }));
}

const allItems = (await loadInitiatives()).sort(sortByLatestThenTitle);
const item = allItems.find((candidate) => candidate.slug === Astro.params.slug);

if (!item) {
  throw new Error(`Unknown initiative slug: ${Astro.params.slug}`);
}

const markdown = await getMarkdownProcessor();
const renderedBody = item.body.trim() ? await markdown.render(item.body) : undefined;
const bySlug = Object.fromEntries(allItems.map((candidate) => [candidate.slug, candidate]));
const byId = Object.fromEntries(allItems.map((candidate) => [candidate.id, candidate]));

const dependencyItems = (item.dependsOn || [])
  .map((dependency) => bySlug[dependency] || byId[dependency])
  .filter(Boolean);
const primaryApproachLabel = formatApproachLabel(item.primaryApproachType);
const secondaryApproachLabels = item.actionsSupported
  .filter((action) => action !== item.primaryApproachType)
  .map((action) => formatApproachLabel(action));

const metricLabels = {
  usersCount: 'Users',
  dataVolume: 'Data volume',
  moneyVolume: 'Payments',
};

const metricEntries = (['usersCount', 'dataVolume', 'moneyVolume'] as const)
  .filter((field) => Boolean(item[field]))
  .map((field) => ({
    field,
    label: metricLabels[field],
    value: item[field],
    evidence: item.metricEvidence?.[field],
  }));

const relatedItems = allItems
  .map((candidate) => ({
    item: candidate,
    sharedActions: candidate.slug === item.slug
      ? 0
      : candidate.actionsSupported.filter((action) => item.actionsSupported.includes(action)).length,
  }))
  .filter((candidate) => candidate.sharedActions > 0)
  .sort((a, b) => {
    if (a.sharedActions !== b.sharedActions) return b.sharedActions - a.sharedActions;
    return sortByLatestThenTitle(a.item, b.item);
  })
  .slice(0, 4)
  .map((candidate) => candidate.item);

const metadataGroups = [
  {
    label: 'Approach types',
    values: item.actionsSupported.map((action) => ACTION_LABELS[action] || action),
  },
  {
    label: 'Pipeline stages',
    values: item.pipelineStages.map((stage) => PIPELINE_LABELS[stage] || stage),
  },
  {
    label: 'Data types',
    values: item.dataTypes.map((dataType) => formatDataTypeLabel(dataType)),
  },
  {
    label: 'Signals',
    values: item.signals,
  },
  {
    label: 'Jurisdictions',
    values: item.jurisdictions,
  },
  {
    label: 'Tags',
    values: item.tags,
  },
].filter((group) => group.values.length > 0);

const latest = item.latestEvidenceLink;
const websiteLabel = formatLinkLabel(item.website);
const newTabAriaLabel = (label: string) => `${label} (opens in a new tab)`;
---

<Layout title={item.title} description={item.summary} type="article">
  <main class="wrap initiative-page">
    <nav class="initiative-breadcrumbs" aria-label="Breadcrumb">
      <a href="/catalog">Catalog</a>
      <span>/</span>
      <span>{item.title}</span>
    </nav>

    <header class="initiative-hero box">
      <div class="initiative-hero-copy">
        <div class="initiative-titleline">
          <h1>{item.title}</h1>
          <span class={`badge ${item.status}`}>{STATUS_LABELS[item.status] || item.status}</span>
        </div>
        <p class="initiative-summary">{item.summary}</p>
        {item.status === 'archived' && (
          <p class="activity-note initiative-archive-note">
            Archived profile. Review did not find newer public activity.
          </p>
        )}

        <div class="initiative-hero-actions">
          <a
            class="btn btn-primary"
            href={item.website}
            target="_blank"
            rel="noopener"
            aria-label={newTabAriaLabel(`${item.title} website`)}
          >
            Visit website
          </a>
          <a class="btn btn-quiet" href="/catalog">Back to catalog</a>
        </div>
      </div>

      <dl class="initiative-hero-meta">
        <div>
          <dt>Website</dt>
          <dd>
            <a
              class="link-shell"
              href={item.website}
              target="_blank"
              rel="noopener"
              title={formatLinkTitle(item.website)}
              aria-label={newTabAriaLabel(websiteLabel)}
            >
              <span class="link-label link-label-single">{websiteLabel}</span>
            </a>
          </dd>
        </div>
        <div>
          <dt>Latest update</dt>
          <dd>
            {latest ? (
              <>
                <span class="initiative-meta-date">{formatDate(latest.date)}</span>
                <a
                  class="link-shell"
                  href={latest.url}
                  target="_blank"
                  rel="noopener"
                  title={formatLinkTitle(latest.url, latest.label)}
                  aria-label={newTabAriaLabel(latest.label)}
                >
                  <span class="link-label link-label-multi">{latest.label}</span>
                </a>
              </>
            ) : (
              <span class="muted">No evidence links yet</span>
            )}
          </dd>
        </div>
        <div>
          <dt>Primary approach</dt>
          <dd>{primaryApproachLabel}</dd>
        </div>
        {secondaryApproachLabels.length > 0 && (
          <div>
            <dt>Also uses</dt>
            <dd>{secondaryApproachLabels.join(' / ')}</dd>
          </div>
        )}
        {item.pipelineStages.length > 0 && (
          <div>
            <dt>Pipeline</dt>
            <dd>{item.pipelineStages.map((stage) => PIPELINE_LABELS[stage] || stage).join(' / ')}</dd>
          </div>
        )}
      </dl>
    </header>

    <div class="initiative-layout">
      <article class="initiative-main">
        {renderedBody && (
          <section class="box section initiative-section">
            <h2>What it is</h2>
            <div class="initiative-prose" set:html={renderedBody.code}></div>
          </section>
        )}

        {item.considerations && (
          <section class="box section initiative-section">
            <h2>Limitations</h2>
            <p class="initiative-callout">{item.considerations}</p>
          </section>
        )}

        {item.evidenceLinks.length > 0 && (
          <section class="box section initiative-section">
            <h2>Evidence trail</h2>
            <ul class="initiative-evidence-list">
              {item.evidenceLinks.map((link) => (
                <li>
                  <span class="initiative-evidence-date">{formatDate(link.date)}</span>
                  <a
                    class="link-shell"
                    href={link.url}
                    target="_blank"
                    rel="noopener"
                    title={formatLinkTitle(link.url, link.label)}
                    aria-label={newTabAriaLabel(link.label)}
                  >
                    <span class="link-label link-label-multi">{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {metricEntries.length > 0 && (
          <section class="box section initiative-section">
            <h2>Adoption signals</h2>
            <div class="initiative-metric-grid">
              {metricEntries.map((metric) => (
                <article class="initiative-metric-card">
                  <p class="initiative-metric-label">{metric.label}</p>
                  <p class="initiative-metric-value">{metric.value}</p>
                  {metric.evidence?.notes && <p class="initiative-metric-note">{metric.evidence.notes}</p>}
                  {metric.evidence?.sources && metric.evidence.sources.length > 0 && (
                    <ul class="initiative-source-list">
                      {metric.evidence.sources.map((source) => (
                        <li>
                          <a
                            class="link-shell"
                            href={source.url}
                            target="_blank"
                            rel="noopener"
                            title={formatLinkTitle(source.url, source.label)}
                            aria-label={newTabAriaLabel(source.label)}
                          >
                            <span class="link-label link-label-multi">{source.label}</span>
                          </a>
                          <span class="initiative-source-date">{formatDate(source.date)}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}

        {item.implementationSnippets && item.implementationSnippets.length > 0 && (
          <section class="box section initiative-section">
            <h2>Examples</h2>
            <div class="snippets-wrap">
              {item.implementationSnippets.map((snippet) => (
                <div class="snippet">
                  <div class="snippet-head">
                    <span class="chip">{snippet.title}</span>
                    {snippet.exampleUrl && (
                      <a
                        class="link-shell"
                        href={snippet.exampleUrl}
                        target="_blank"
                        rel="noopener"
                        title={formatLinkTitle(snippet.exampleUrl, snippet.exampleLabel || `${snippet.title} example`)}
                        aria-label={newTabAriaLabel(snippet.exampleLabel || `${snippet.title} example`)}
                      >
                        <span class="link-label link-label-single">{snippet.exampleLabel || 'Example'}</span>
                      </a>
                    )}
                    {snippet.sourceUrl && (
                      <a
                        class="link-shell"
                        href={snippet.sourceUrl}
                        target="_blank"
                        rel="noopener"
                        title={formatLinkTitle(snippet.sourceUrl, `${snippet.title} source`)}
                        aria-label={newTabAriaLabel(`${snippet.title} source`)}
                      >
                        <span class="link-label link-label-single">Source</span>
                      </a>
                    )}
                    <button type="button" class="copy" data-code={encodeURIComponent(snippet.code || '')}>Copy</button>
                  </div>
                  {snippet.summary && <p class="snippet-summary">{snippet.summary}</p>}
                  <pre class="code"><code>{snippet.code}</code></pre>
                </div>
              ))}
            </div>
          </section>
        )}

        {item.referencesResolved.length > 0 && (
          <section class="box section initiative-section">
            <h2>References</h2>
            <ul class="references-list">
              {item.referencesResolved.map((reference) => (
                <li>
                  {reference.url ? (
                    <a
                      class="link-shell"
                      href={reference.url}
                      target="_blank"
                      rel="noopener"
                      title={formatLinkTitle(reference.url, formatCitation(reference))}
                      aria-label={newTabAriaLabel(formatCitation(reference))}
                    >
                      <span class="link-label link-label-multi">{formatCitation(reference)}</span>
                    </a>
                  ) : (
                    <span>{formatCitation(reference)}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      <aside class="initiative-sidebar">
        {metadataGroups.map((group) => (
          <section class="box section initiative-sidecard">
            <h2>{group.label}</h2>
            <div class="initiative-chip-list">
              {group.values.map((value) => (
                <span class="chip">{value}</span>
              ))}
            </div>
          </section>
        ))}

        {dependencyItems.length > 0 && (
          <section class="box section initiative-sidecard">
            <h2>Uses</h2>
            <ul class="initiative-link-list">
              {dependencyItems.map((dependency) => (
                <li>
                  <a href={`/initiatives/${dependency.slug}`}>{dependency.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {relatedItems.length > 0 && (
          <section class="box section initiative-sidecard">
            <h2>Related in catalog</h2>
            <ul class="initiative-link-list">
              {relatedItems.map((related) => (
                <li>
                  <a href={`/initiatives/${related.slug}`}>{related.title}</a>
                  {related.latestUpdate && (
                    <span class="initiative-link-meta">Updated {formatDate(related.latestUpdate)}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </main>
</Layout>

<style>
  .initiative-page {
    display: grid;
    gap: 14px;
  }

  .initiative-breadcrumbs {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .initiative-breadcrumbs a {
    color: var(--accent);
    text-decoration: none;
  }

  .initiative-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: 22px;
    padding: 16px 0 18px;
    border-width: 1px 0;
    background: transparent;
  }

  .initiative-hero-copy {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .initiative-titleline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .initiative-summary {
    margin: 0;
    max-width: 42rem;
    color: color-mix(in srgb, var(--text) 84%, var(--muted));
    font-size: 1rem;
  }

  .initiative-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2px;
  }

  .initiative-hero-actions .btn {
    min-height: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .initiative-hero-actions .btn:hover,
  .initiative-hero-actions .btn:focus-visible {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .initiative-hero-meta {
    display: grid;
    align-content: start;
    gap: 0;
    margin: 0;
    border: 1px solid var(--border);
    background: var(--card);
  }

  .initiative-hero-meta div {
    padding: 10px 12px;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
  }

  .initiative-hero-meta div:last-child {
    border-bottom: 0;
  }

  .initiative-hero-meta dt {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
  }

  .initiative-hero-meta dd {
    display: grid;
    gap: 0.35rem;
    margin: 0.45rem 0 0;
  }

  .initiative-meta-date {
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .initiative-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.72fr);
    gap: 18px;
    align-items: start;
  }

  .initiative-main {
    display: grid;
    gap: 14px;
  }

  .initiative-sidebar {
    position: sticky;
    top: 90px;
    display: grid;
    gap: 14px;
  }

  .initiative-section h2,
  .initiative-sidecard h2 {
    margin-bottom: 0.65rem;
    font-size: 1.35rem;
  }

  .initiative-prose :global(p:first-child) {
    margin-top: 0;
  }

  .initiative-prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .initiative-prose :global(p),
  .initiative-prose :global(li) {
    font-size: 1rem;
    line-height: 1.68;
  }

  .initiative-prose :global(h2),
  .initiative-prose :global(h3) {
    scroll-margin-top: 100px;
  }

  .initiative-callout {
    margin: 0;
    padding: 10px 12px;
    border-left: 3px solid var(--accent);
    border-radius: 0;
    background: transparent;
    color: color-mix(in srgb, var(--text) 84%, var(--muted));
  }

  .initiative-evidence-list,
  .initiative-source-list,
  .initiative-link-list {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.65rem;
  }

  .initiative-evidence-list li,
  .initiative-source-list li,
  .initiative-link-list li {
    display: grid;
    gap: 0.2rem;
  }

  .initiative-evidence-date,
  .initiative-source-date,
  .initiative-link-meta {
    font-size: 0.84rem;
    color: var(--muted);
  }

  .initiative-metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }

  .initiative-metric-card {
    padding: 12px;
    border-radius: 0;
    border: 1px solid var(--border);
    background: var(--card);
  }

  .initiative-metric-label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
  }

  .initiative-metric-value {
    margin: 0.45rem 0 0.7rem;
    font-family: var(--font-display);
    font-size: 1.65rem;
    line-height: 1.12;
  }

  .initiative-metric-note {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .initiative-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 960px) {
    .initiative-hero,
    .initiative-layout {
      grid-template-columns: 1fr;
    }

    .initiative-sidebar {
      position: static;
    }
  }

  @media (max-width: 720px) {
    .initiative-hero {
      padding: 16px 0;
    }

    .initiative-hero-actions .btn {
      width: 100%;
      justify-content: flex-start;
    }

    .initiative-titleline {
      align-items: flex-start;
    }
  }
</style>
