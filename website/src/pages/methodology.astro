---
import Layout from '../layouts/Layout.astro';

const principles = [
  {
    title: 'Human-curated',
    body: 'People decide what belongs in the catalog, how entries are described, and which caveats need to stay attached.',
  },
  {
    title: 'AI-supported, not AI-published',
    body: 'AI agents can help gather candidate links, summarize changes, and draft update packets, but they do not make final decisions or publish directly to the site.',
  },
  {
    title: 'Evidence-led',
    body: 'A useful update should point to public sources that a human reviewer can open, inspect, and challenge.',
  },
];

const idealFlow = [
  'Start with a person. A contributor or editor identifies a new initiative or an existing entry that may need an update.',
  'Read the current entry first. Before changing anything, check what the catalog already says and what evidence is already attached.',
  'Look for the strongest public sources. Official websites, docs, announcements, changelogs, repos, and public filings should usually come before secondary coverage.',
  'Use AI carefully, if helpful. An agent can scan for recent changes, gather candidate links, and draft a compact proposed update, but it should stay close to the source material and keep uncertainty visible.',
  'Review every proposed claim by hand. A human should open the links, confirm the dates, check that the summary is fair, and throw out anything weak, vague, or overstated.',
  'Keep the update conservative. If the evidence is partial or ambiguous, the entry should say so plainly rather than smoothing it over.',
  'Publish through human review. A person makes the final merge decision and remains responsible for the wording and the evidence attached to the entry.',
];

const goodUpdate = [
  'A short factual summary of what changed.',
  'At least one public source that supports the update.',
  'Clear dates when timing matters.',
  'Plain language about any uncertainty, limits, or open questions.',
];
---

<Layout
  title="Methodology"
  description="How DataLicenses.org stays human-curated while using AI carefully to support research and updates."
>
  <main class="wrap narrow methodology-page">
    <header class="page-header">
      <p class="eyebrow">How we work</p>
      <h1>Methodology</h1>
      <p class="muted methodology-intro">
        DataLicenses.org is a human-curated catalog. People decide what belongs here, how entries are
        phrased, and what caveats should stay visible. AI agents can be useful research assistants, but
        they are only there to support update work, not replace editorial judgment.
      </p>
    </header>

    <section class="methodology-grid">
      {principles.map((principle) => (
        <article class="box section methodology-card">
          <h2>{principle.title}</h2>
          <p>{principle.body}</p>
        </article>
      ))}
    </section>

    <section class="box section">
      <h2>Ideal Flow</h2>
      <p class="muted">
        The ideal process is simple: use tools to make the research work easier, then keep the editorial
        decision-making firmly human.
      </p>
      <ol class="method-list">
        {idealFlow.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </section>

    <section class="box section">
      <h2>What A Good Update Includes</h2>
      <ul class="method-list">
        {goodUpdate.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="muted small">
        When AI is involved, the best outcome is usually a small review packet: candidate sources, a proposed
        summary, and clear notes about anything uncertain or unresolved.
      </p>
    </section>
  </main>
</Layout>

<style>
  .methodology-intro {
    max-width: 48rem;
  }

  .methodology-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .methodology-card {
    background: color-mix(in srgb, var(--card) 94%, transparent);
  }

  .methodology-card h2 {
    margin-bottom: 0.55rem;
  }

  .method-list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.65rem;
  }
</style>
