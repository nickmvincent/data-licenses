---
import Layout from '../layouts/Layout.astro';
import { loadMethodologyPage } from '../lib/content-loader';
import { getMarkdownProcessor } from '../lib/markdown';

const guide = await loadMethodologyPage();
const markdown = await getMarkdownProcessor();
const rendered = await markdown.render(guide.body);

const title =
  typeof guide.frontmatter?.title === 'string' ? guide.frontmatter.title : 'Method & Contribute';
const description =
  typeof guide.frontmatter?.description === 'string'
    ? guide.frontmatter.description
    : 'How the catalog is reviewed, what belongs here, and how to contribute.';
const stripTags = (value: string) => value.replace(/<[^>]+>/g, '');
const decodeEntities = (value: string) =>
  value
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>');
const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
const headingIdPattern = /\sid="([^"]+)"/;
const seenHeadingIds = new Map<string, number>();

const guideBodyHtml = rendered.code.replace(/<h([23])([^>]*)>(.*?)<\/h\1>/g, (_match, level, attrs, inner) => {
  const text = decodeEntities(stripTags(inner)).trim();
  const existingId = attrs.match(headingIdPattern)?.[1];
  const base = existingId || slugify(text);

  if (!base) {
    return `<h${level}${attrs}>${inner}</h${level}>`;
  }

  const seenCount = seenHeadingIds.get(base) || 0;
  seenHeadingIds.set(base, seenCount + 1);
  const id = seenCount === 0 ? base : `${base}-${seenCount + 1}`;
  const nextAttrs = existingId
    ? seenCount === 0
      ? attrs
      : attrs.replace(headingIdPattern, ` id="${id}"`)
    : `${attrs} id="${id}"`;

  return `<h${level}${nextAttrs}>${inner}</h${level}>`;
});
---

<Layout title={title} description={description}>
  <main class="wrap narrow methodology-page">
    <header class="page-header guide-hero">
      <h1 class="page-title-sm">{title}</h1>

      <div class="guide-actions">
        <a
          class="btn btn-primary"
          href="https://github.com/nickmvincent/data-licenses/issues/new/choose"
          target="_blank"
          rel="noopener"
        >
          Open an issue
        </a>
        <a
          class="btn"
          href="https://github.com/nickmvincent/data-licenses/compare"
          target="_blank"
          rel="noopener"
        >
          Open a PR
        </a>
        <a
          class="btn btn-quiet"
          href="https://nickmvincent.com"
          target="_blank"
          rel="noopener"
        >
          Contact
        </a>
      </div>
    </header>

    <article class="methodology-body memo box section" set:html={guideBodyHtml}></article>
  </main>
</Layout>

<style>
  .methodology-page {
    display: grid;
    gap: 16px;
  }

  .guide-hero {
    display: grid;
    gap: 12px;
  }

  .guide-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .methodology-body {
    padding: 24px 28px;
  }

  .methodology-body :global(h2:first-child) {
    margin-top: 0;
  }

  .methodology-body :global(h2),
  .methodology-body :global(h3) {
    scroll-margin-top: 100px;
  }

  .methodology-body :global(p),
  .methodology-body :global(li),
  .methodology-body :global(a) {
    overflow-wrap: anywhere;
  }

  .methodology-body :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .guide-actions .btn {
      width: 100%;
    }

    .methodology-body {
      padding: 22px;
    }
  }
</style>
