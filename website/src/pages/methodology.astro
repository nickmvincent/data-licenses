---
import Layout from '../layouts/Layout.astro';

const sourceTiers = [
  {
    title: 'Tier 1: Primary sources',
    body: 'Official websites, docs, specs, repos, changelogs, press releases, filings, and product announcements. These should anchor most evidence links and all adoption metrics when possible.',
  },
  {
    title: 'Tier 2: Reputable secondary coverage',
    body: 'Independent reporting can confirm timing or context, but it should usually supplement a primary source rather than replace one.',
  },
  {
    title: 'Tier 3: Weak signals',
    body: 'Social chatter, scraped profiles, vague marketing language, or undated pages can suggest leads, but they should not be treated as settled catalog facts.',
  },
];

const workflowSteps = [
  'Start with the initiative record already in the catalog: canonical website, current evidence links, and any existing metrics.',
  'Check official sources first. For each initiative, look at its website, docs, repo, press page, and any public specification or product documentation.',
  'Capture the newest dated public update that reflects a meaningful change. This becomes the best candidate for the newest `evidenceLinks` item.',
  'Look for explicit public adoption claims. Good examples are partner counts, publisher counts, dataset counts, queries, pages, or disclosed payment volume.',
  'Keep the wording conservative. If a source says "over 700 publishers," use `700+ publishers` rather than a more aggressive interpretation.',
  'Hand off the candidate evidence to a human reviewer before merge. AI agents are for first-pass collection, not silent publication.',
];

const checklist = [
  'Every proposed update should have at least one clickable source and a date.',
  'Every `usersCount`, `dataVolume`, or `moneyVolume` value should be grounded in public evidence and paired with `metricEvidence`.',
  'If the evidence is weak, stale, or contradictory, say so in `considerations`, the PR, or the review note instead of smoothing it over.',
  'Use absolute dates, short factual labels, and neutral summaries.',
  'Do not infer adoption from website traffic, social followers, GitHub stars, or general media attention.',
];

const fieldRows = [
  {
    field: 'website',
    use: 'The canonical home for the initiative. Prefer the initiative itself over a news story about it.',
  },
  {
    field: 'evidenceLinks',
    use: 'Dated public links that show updates, launches, deployments, partnerships, or adoption signals. The newest one drives the catalog\'s "Latest update" display.',
  },
  {
    field: 'evidenceStatus',
    use: 'Derived editorial status: `tracked` when an initiative already has at least one dated evidence link, `needs-sourcing` when it still needs a basic public source pass.',
  },
  {
    field: 'usersCount',
    use: 'A short public count of adopters, publishers, partners, customers, or users. Only include it if a source explicitly states a number.',
  },
  {
    field: 'dataVolume',
    use: 'A short public measure of data flow or corpus size, such as datasets, pages, tokens, or downloads.',
  },
  {
    field: 'moneyVolume',
    use: 'A short public measure of payments, revenue share, contract value, or other directly relevant economic activity.',
  },
  {
    field: 'metricEvidence',
    use: 'Per-metric attribution for `usersCount`, `dataVolume`, and `moneyVolume`. Use `basis: explicit` for direct source claims and `basis: derived` only for simple, well-explained rollups across official sources.',
  },
  {
    field: 'considerations',
    use: 'Caveats about scope, compliance, enforcement, uncertainty, or what the evidence does not prove.',
  },
  {
    field: 'adoptionResearchStatus',
    use: 'Editorial research bucket for adoption metrics: `populated`, `needs-research`, or `hard-to-quantify`.',
  },
  {
    field: 'adoptionResearchNotes',
    use: 'Short explanation of why the initiative currently sits in that adoption-research bucket.',
  },
];

const exampleJson = `{
  "slug": "example-initiative",
  "title": "Example Initiative",
  "website": "https://example.org",
  "evidenceLinks": [
    {
      "label": "Partner program announced",
      "url": "https://example.org/blog/partners",
      "date": "2026-01-15"
    },
    {
      "label": "Docs updated with rollout details",
      "url": "https://example.org/docs/partners",
      "date": "2025-12-02"
    }
  ],
  "usersCount": "10+ announced partners",
  "metricEvidence": {
    "usersCount": {
      "basis": "explicit",
      "sources": [
        {
          "label": "Partner program announced",
          "url": "https://example.org/blog/partners",
          "date": "2026-01-15"
        }
      ]
    }
  },
  "considerations": "Partner count comes from the launch post and may understate current uptake."
}`;

const exampleFrontmatter = `---
title: Example Initiative
summary: One-line neutral summary.
status: live
website: 'https://example.org/'
evidenceLinks:
  - label: Partner program announced
    url: 'https://example.org/blog/partners'
    date: '2026-01-15'
  - label: Docs updated with rollout details
    url: 'https://example.org/docs/partners'
    date: '2025-12-02'
usersCount: '10+ announced partners'
metricEvidence:
  usersCount:
    basis: explicit
    sources:
      - label: Partner program announced
        url: 'https://example.org/blog/partners'
        date: '2026-01-15'
considerations: Partner count comes from the launch post and may understate current uptake.
---`;
---

<Layout
  title="Methodology"
  description="How DataLicenses.org verifies initiative updates, adoption claims, and AI-assisted contribution research."
>
  <main class="wrap narrow methodology-page">
    <header class="page-header">
      <p class="eyebrow">How we verify things</p>
      <h1>Methodology</h1>
      <p class="muted methodology-intro">
        DataLicenses.org uses AI agents for first-pass research, but the catalog itself is evidence-led.
        We only want updates and adoption signals that a contributor or reader can click through,
        date, and sanity-check.
      </p>
    </header>

    <section class="methodology-grid">
      <article class="box section methodology-card">
        <h2>Latest update</h2>
        <p>
          The site's "Latest update" value is derived from the newest dated <code>evidenceLinks</code>
          entry attached to an initiative. If we do not have a dated public source, we should leave the
          field sparse rather than invent recency.
        </p>
      </article>

      <article class="box section methodology-card">
        <h2>Adoption metrics</h2>
        <p>
          Counts like <code>usersCount</code>, <code>dataVolume</code>, and <code>moneyVolume</code>
          should be short summaries of explicit public claims. We use conservative phrasing and avoid
          extrapolating beyond what the source actually says. Each metric should also carry a
          matching <code>metricEvidence</code> entry so contributors can see exactly what supports it.
        </p>
      </article>

      <article class="box section methodology-card">
        <h2>Agent-first, human-reviewed</h2>
        <p>
          AI agents are welcome for collecting candidate evidence and summarizing it. A human should still
          decide what gets merged into the catalog and how caveats are represented.
        </p>
      </article>
    </section>

    <section class="box section">
      <h2>Research Workflow</h2>
      <ol class="method-list">
        {workflowSteps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p class="muted small">
        Starter assets: <a href="/data/initiatives.json">catalog JSON</a>,
        <a href="/data/curation.json"> curation JSON</a>, and the
        <a href="/prompts/find-updates.txt"> update-research prompt</a>.
      </p>
    </section>

    <section class="box section">
      <h2>Source Ladder</h2>
      <div class="methodology-grid">
        {sourceTiers.map((tier) => (
          <article class="methodology-card tier-card">
            <h3>{tier.title}</h3>
            <p>{tier.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="box section">
      <h2>What We Record</h2>
      <div class="method-table-wrap">
        <table class="method-table">
          <thead>
            <tr>
              <th>Field</th>
              <th>How we use it</th>
            </tr>
          </thead>
          <tbody>
            {fieldRows.map((row) => (
              <tr>
                <td><code>{row.field}</code></td>
                <td>{row.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="box section">
      <h2>Rules For Adoption Metrics</h2>
      <ul class="method-list">
        <li>Use explicit public counts or ranges whenever possible. If a source does not state a number, omit the metric.</li>
        <li>Keep the wording close to the source. Examples: <code>700+ publishers</code>, <code>10+ announced partners</code>, <code>200,000+ declarations</code>.</li>
        <li>If a metric is a simple rollup across multiple official sources, record that in <code>metricEvidence</code> with <code>basis: derived</code> and a short note.</li>
        <li>Do not translate soft marketing language like "widely used" into a numeric claim.</li>
        <li>Do not estimate adoption from stars, followers, backlinks, or scraped traffic tools.</li>
        <li>If the best available evidence is old or partial, keep the metric conservative and note the caveat.</li>
      </ul>
    </section>

    <section class="box section">
      <h2>Review Checklist</h2>
      <ul class="method-list">
        {checklist.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="box section">
      <h2>Curation Backlog</h2>
      <p>
        We now track two editorial statuses in structured form. <code>evidenceStatus</code> tells us whether an
        initiative has at least one dated public evidence link. <code>adoptionResearchStatus</code> tells us whether
        adoption metrics are already populated, still worth researching, or probably hard to quantify for now.
      </p>
      <p>
        Contributors and agents can inspect the current backlog at <a href="/data/curation.json">/data/curation.json</a>.
      </p>
    </section>

    <section class="box section">
      <h2>AI Agent Output Contract</h2>
      <p>
        We want AI-generated research to be structured enough for review and close to merge-ready.
        The easiest path is a flat initiative object using the same field names the catalog already stores.
      </p>
      <pre class="method-code"><code>{exampleJson}</code></pre>
    </section>

    <section class="box section">
      <h2>Catalog Snippet</h2>
      <p>
        After review, the mergeable catalog object should stay compact. The key thing is that the public
        evidence remains attached to the initiative entry.
      </p>
      <pre class="method-code"><code>{exampleFrontmatter}</code></pre>
    </section>

    <section class="box section">
      <h2>Contributor Checklist</h2>
      <ul class="method-list">
        {checklist.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="muted small">
        Contributions are easier to review when the PR or note also says which sources were checked and what was
        ruled out as too weak to include.
      </p>
    </section>
  </main>
</Layout>

<style>
  .methodology-intro {
    max-width: 48rem;
  }

  .methodology-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .methodology-card {
    background: color-mix(in srgb, var(--card) 94%, transparent);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 18px;
  }

  .tier-card h3,
  .methodology-card h2 {
    margin-bottom: 0.55rem;
  }

  .method-list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.65rem;
  }

  .method-table-wrap {
    overflow-x: auto;
  }

  .method-table {
    width: 100%;
    border-collapse: collapse;
  }

  .method-table th,
  .method-table td {
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .method-table th {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .method-code {
    overflow-x: auto;
    padding: 16px 18px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-muted) 88%, transparent);
    font-size: 0.88rem;
    line-height: 1.55;
  }
</style>
