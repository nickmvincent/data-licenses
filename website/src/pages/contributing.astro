---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contribute"
  description="How to suggest updates, sources, and new initiatives for DataLicenses.org."
>
  <main class="wrap narrow contribute-page">
    <header class="page-header contribute-hero">
      <h1 class="page-title-sm">Contribute</h1>
      <p class="muted contribute-intro">
        Start with the methodology page for scope, sourcing rules, and contribution steps.
      </p>

      <div class="contribute-actions">
        <a class="btn btn-primary" href="/methodology#contribute">Open guide</a>
        <a class="btn" href="/methodology#how-we-collect-initiatives">Collection method</a>
      </div>
    </header>

    <section class="box section">
      <p>
        Start on the <a href="/methodology">methodology page</a> for the checklist,
        workflow, and links to open an issue or pull request.
      </p>
    </section>
  </main>
</Layout>

<style>
  .contribute-page {
    display: grid;
    gap: 2px;
  }

  .contribute-hero {
    display: grid;
    gap: 12px;
  }

  .contribute-intro {
    margin: 0;
    max-width: 40rem;
  }

  .contribute-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 720px) {
    .contribute-actions .btn {
      width: 100%;
    }
  }
</style>
