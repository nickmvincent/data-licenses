---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contribute"
  description="The contribution guide now lives on the combined method and contribute page."
>
  <main class="wrap narrow contribute-page">
    <header class="page-header contribute-hero">
      <p class="eyebrow">Page moved</p>
      <h1>Contribute</h1>
      <p class="muted contribute-intro">
        The contribution guide now lives with the method page, so scope, sourcing rules, and
        contribution steps stay in one place.
      </p>

      <div class="contribute-actions">
        <a class="btn btn-primary" href="/methodology#contribute">Open guide</a>
        <a class="btn" href="/methodology#resources">Research inputs</a>
      </div>
    </header>

    <section class="box section">
      <p>
        Start on the <a href="/methodology">method and contribute page</a> for the checklist,
        workflow, and links to open an issue or pull request.
      </p>
    </section>
  </main>
</Layout>

<style>
  .contribute-page {
    display: grid;
    gap: 2px;
  }

  .contribute-hero {
    display: grid;
    gap: 12px;
  }

  .contribute-intro {
    margin: 0;
    max-width: 40rem;
  }

  .contribute-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 720px) {
    .contribute-actions .btn {
      width: 100%;
    }
  }
</style>
